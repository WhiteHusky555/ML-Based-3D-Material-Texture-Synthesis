<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">V35HSrEaTeu3bE/WS8p9PQAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">49K1D0rpQrqnIm1o3zZM6QAA</XPD:REF>
</XPD:OBJ>
