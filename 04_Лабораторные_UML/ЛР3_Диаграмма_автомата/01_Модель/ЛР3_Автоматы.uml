<XPD:REF name="Views[1]">dt08CTsJS4CxQIRC7ceIdQAA</XPD:REF>
<XPD:REF name="Views[2]">Je8I2YJKS0CI7YPijrtAAAAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="hA7noYBNTcmr0Oclub31HwAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">RsLHsc6CSx2BanAuwWv3aQAA</XPD:REF>
</XPD:OBJ>
