<XPD:REF name="OwnerPartitions[0]">s2ic6SlLSzGleMm5d1DQzgAA</XPD:REF>
<XPD:ATTR name="#Outgoings" type="integer">1</XPD:ATTR>
<XPD:REF name="Outgoings[0]">Kxz4ffeuRAmwFAbe1GvmMgAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Subvertices[1]" type="UMLActionState" guid="RSWMvt7sQeKjADxb1ulXcAAA">
<XPD:ATTR name="Name" type="string">Постановка цепочки задач в очередь</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">API-сервис ставит цепочку Celery noise → generate → upscale → pbr с приоритетом по тарифу (премиум — высокий) в очереди noise, gpu и cpu.</XPD:ATTR>
<XPD:REF name="ContainerState">lPUh4MSkQaSgUjpetFNvqQAA</XPD:REF>
