<XPD:REF name="Outgoings[0]">7MwRPGjZQc+KvJjhkLmV3AAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Subvertices[1]" type="UMLActionState" guid="5JYph0I+Q6G2LSnRXSZzkAAA">
<XPD:ATTR name="Name" type="string">Получение прав тарифа пользователя</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Система (API-сервис) берёт тариф из заголовка X-User-Plan и читает права тарифа у сервиса пользователей (GET /internal/plans/{plan}): лимит генераций в сутки, разрешения, шаги, варианты, доступ к референсу.</XPD:ATTR>
<XPD:REF name="ContainerState">kDMLxvPsRJiaEYXDN0h6jQAA</XPD:REF>
