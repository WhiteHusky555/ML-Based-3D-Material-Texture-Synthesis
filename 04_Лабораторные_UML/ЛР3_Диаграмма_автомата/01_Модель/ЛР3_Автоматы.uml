</XPD:OBJ>
<XPD:OBJ name="Subvertices[1]" type="UMLCompositeState" guid="P/VDXS+8SL+oAlVn6EJvCQAA">
<XPD:ATTR name="Name" type="string">Проверка роли</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Простое состояние: сервер читает роль учётной записи из базы при каждом запросе; роль analyst обязательна. Деятельности состояния семантически просты, отдельная диаграмма не приводится.</XPD:ATTR>
<XPD:REF name="ContainerState">T3ed6CNSTUGEkgdJQSe3EwAA</XPD:REF>
