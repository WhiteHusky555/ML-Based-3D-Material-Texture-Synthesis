<XPD:ATTR name="Name" type="string">нажата «Войти»</XPD:ATTR>
<XPD:REF name="Transition">mIqnlUuLT4+yNsLrZMT/bAAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
<XPD:OBJ name="Transitions[5]" type="UMLTransition" guid="q9Tsz+EhTuW9lagye/JoXwAA">
