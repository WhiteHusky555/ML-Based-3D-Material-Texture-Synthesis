<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">Fv20xH5zQbqFVjgPifqowQAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">1sUJ1ideSh6n7WTITGcUcQAA</XPD:REF>
</XPD:OBJ>
