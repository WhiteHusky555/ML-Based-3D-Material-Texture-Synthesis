<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">p7whsJOSQ72NUhwPAegsmwAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
