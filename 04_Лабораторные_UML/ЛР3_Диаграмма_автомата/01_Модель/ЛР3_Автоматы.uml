<XPD:OBJ name="DoActivities[0]" type="UMLUninterpretedAction" guid="CBeVogoEQ2OGreti0froUgAA">
<XPD:ATTR name="Name" type="string">Показ окна и реакция на действия</XPD:ATTR>
<XPD:REF name="DoActivityState">iXtOTfRoRQOJoSs18zLQ8gAA</XPD:REF>
</XPD:OBJ>
