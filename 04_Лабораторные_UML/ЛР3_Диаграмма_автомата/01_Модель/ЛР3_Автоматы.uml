<XPD:REF name="StateMachine">K5RUDpTBTCWrt/xYd2KZ5gAA</XPD:REF>
<XPD:ATTR name="#Subvertices" type="integer">12</XPD:ATTR>
<XPD:OBJ name="Subvertices[0]" type="UMLPseudostate" guid="9KscTBFOS7GlApaGGFJgqQAA">
<XPD:ATTR name="Documentation" type="string">Начальное псевдосостояние автомата «Сценарий работы владельца с системой».</XPD:ATTR>
