<XPD:REF name="Views[1]">kQxnz2dwQfu2qHTZzOqn3gAA</XPD:REF>
<XPD:REF name="Views[2]">KFSp0DUZRfmf9sz2rpQE2QAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="9EW/lFLJTt6wbcoSpwvbxAAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">k7Sd9lR5QNygAr7fkVL6CAAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#Effects" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Effects[0]" type="UMLUninterpretedAction" guid="G/7EjmTXSEC9aAyPsbpaCQAA">
<XPD:ATTR name="Name" type="string">Действие := выбранное</XPD:ATTR>
