<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">Cqhqm8Q/R12PCVo31ofGTgAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">2</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">kk7jamFPRFWIou2THrnMMwAA</XPD:REF>
<XPD:REF name="SubmachineStates[1]">UsqWOje9RS2zEzV44OJO/gAA</XPD:REF>
</XPD:OBJ>
