<XPD:REF name="Views[1]">EF1wT4HyS+Ku3J8gic9xawAA</XPD:REF>
<XPD:REF name="Views[2]">9D1FaIYsTZyOTsBFP1Tn6gAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="lDCj8VFSTXGdFGyMiEnAagAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">SdxC4K4uTvy07A0lOqWHmAAA</XPD:REF>
</XPD:OBJ>
