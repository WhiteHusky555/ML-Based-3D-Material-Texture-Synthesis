<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">c7yuIZyETg2GeZwOcfPEoQAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">XGr+TXSyQlqIgyomzrQDtQAA</XPD:REF>
</XPD:OBJ>
