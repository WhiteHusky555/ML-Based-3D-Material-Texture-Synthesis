</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">VEq56t5wSfuQwDtBIkR3gwAA</XPD:REF>
</XPD:OBJ>
