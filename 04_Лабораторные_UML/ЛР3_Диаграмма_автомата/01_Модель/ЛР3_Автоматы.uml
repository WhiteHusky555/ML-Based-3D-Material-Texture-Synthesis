<XPD:OBJ name="Effects[0]" type="UMLUninterpretedAction" guid="VfbU2ZLFRf6gTkFpeb29BgAA">
<XPD:ATTR name="Name" type="string">Действие := выбранное</XPD:ATTR>
<XPD:REF name="Transition">SdxC4K4uTvy07A0lOqWHmAAA</XPD:REF>
