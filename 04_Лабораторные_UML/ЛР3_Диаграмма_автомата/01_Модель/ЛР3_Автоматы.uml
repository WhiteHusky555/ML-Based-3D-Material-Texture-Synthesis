<XPD:OBJ name="DoActivities[0]" type="UMLUninterpretedAction" guid="BiDLEtCnTQSs08TKug2YhAAA">
<XPD:ATTR name="Name" type="string">Показ окна и реакция на действия</XPD:ATTR>
<XPD:REF name="DoActivityState">EHDUjrr2RxiB7uW/D2M7XQAA</XPD:REF>
