				{
					"_type": "UMLActivity",
					"_id": "g7WR0dxJQzyYyRY73j8=",
					"_parent": {
						"$ref": "44R2z275SzmtpUeHYGg="
					},
					"name": "Просмотр материала цепочки в 3D",
					"documentation": "Реализует прецедент «Просмотр материала цепочки в 3D». Система выдаёт временные ссылки S3 на карты выбранного шага уменьшенного разрешения (1024²) и показывает материал на сфере с переключением карт и формы объекта, как в «Просмотре материала в 3D»; кнопок скачивания и экспорта нет. Если файлы удалены по сроку хранения, вместо 3D показывается «файлы удалены», параметры шага остаются видны. Деятельность семантически проста, её алгоритм полностью раскрыт в описании, поэтому отдельная диаграмма реализации не приводится."
				},
				{
					"_type": "UMLActivity",
					"_id": "H9y1U0J3THmb+K1dm3I=",
					"_parent": {
						"$ref": "44R2z275SzmtpUeHYGg="
					},
					"name": "Просмотр опубликованной цепочки",
					"documentation": "Алгоритм реализации варианта использования «Просмотр опубликованной цепочки»: проверка ссылки и загрузка снимка, просмотр шагов и 3D-просмотр материалов гостем, продолжение цепочки у себя после входа.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "13TJLK9IS1meVHfgVrk=",
							"_parent": {
								"$ref": "H9y1U0J3THmb+K1dm3I="
							},
							"name": "Гость",
							"nodes": [
								{
									"_type": "UMLForkNode",
									"_id": "+OqRM5fhRumrjF5gitY=",
									"_parent": {
										"$ref": "13TJLK9IS1meVHfgVrk="
									},
									"name": "",
									"documentation": "Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Просмотр шагов и выбор действия» и «Отображение снимка цепочки» — окно отображается, пока пользователь работает с ним."
								},
								{
									"_type": "UMLAction",
									"_id": "vw2Ok0KwQ8aPfW70P2A=",
									"_parent": {
										"$ref": "13TJLK9IS1meVHfgVrk="
									},
									"name": "Просмотр шагов и выбор действия",
									"documentation": "Гость листает шаги цепочки и выбирает шаг с готовым материалом, нажимает «Продолжить у себя» или закрывает страницу."
								},
								{
									"_type": "UMLJoinNode",
									"_id": "KxGtx2/ISF6QzAkUvcc=",
									"_parent": {
										"$ref": "13TJLK9IS1meVHfgVrk="
									},
									"name": "",
									"documentation": "Узел синхронизации (Join): ожидает завершения параллельных деятельностей «Отображение снимка цепочки» и «Просмотр шагов и выбор действия» и только затем передаёт управление дальше."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "RaFegLm1Rf+kZueqUyo=",
									"_parent": {
										"$ref": "13TJLK9IS1meVHfgVrk="
									},
									"name": "",
									"documentation": "Конечное состояние: гость закрыл страницу."
								}
							],
							"documentation": "Раздел активности (плавательная дорожка) «Гость»: состояния, выполняемые исполнителем «Гость»."
						},
