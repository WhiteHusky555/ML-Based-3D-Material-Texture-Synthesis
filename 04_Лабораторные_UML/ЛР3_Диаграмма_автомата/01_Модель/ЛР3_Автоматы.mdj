											},
											"name": "",
											"kind": "initial",
											"documentation": "Начальное псевдосостояние автомата «Сценарий работы пользователя с системой»."
										},
										{
											"_type": "UMLState",
											"_id": "b1e/MLizRZ+KX8KBZBI=",
											"_parent": {
												"$ref": "cniQoWH6QkCB7rixRJs="
											},
											"name": "вход",
											"submachine": {
												"$ref": "Rf61rj/URpKNo6H52Gw="
											},
											"documentation": "Ссылочное состояние (submachine): выполнение автомата «Регистрация и вход в систему»; его алгоритм приведён на отдельной диаграмме."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "xlJ9cLZpTeWeQdAbl08=",
											"_parent": {
												"$ref": "cniQoWH6QkCB7rixRJs="
											},
											"name": "",
											"kind": "choice",
											"documentation": "Псевдосостояние выбора: выполнен ли вход в систему."
										},
										{
											"_type": "UMLFinalState",
