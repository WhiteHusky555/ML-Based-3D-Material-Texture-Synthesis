				{
					"_type": "UMLActivity",
					"_id": "cYr+3CnIQBSFOkfclII=",
					"_parent": {
						"$ref": "XJ0WmOugSDSn4vwELSc="
					},
					"name": "Работа со ссылкой на цепочку",
					"documentation": "Реализует прецеденты «Публикация цепочки по ссылке» и «Отзыв ссылки на цепочку»: окно публикации с предупреждением, создание или обновление снимка цепочки без личных данных, выдача ссылки, отключение ссылки.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "WXnny85AT8Kme+Pbm1Q=",
							"_parent": {
								"$ref": "cYr+3CnIQBSFOkfclII="
							},
							"name": "Пользователь",
							"nodes": [
								{
									"_type": "UMLForkNode",
									"_id": "L4NqGzO7Tzmj1DJPnIg=",
									"_parent": {
										"$ref": "WXnny85AT8Kme+Pbm1Q="
									},
									"name": "",
									"documentation": "Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Выбор действия со ссылкой» и «Отображение окна публикации» — окно отображается, пока пользователь работает с ним."
								},
								{
									"_type": "UMLAction",
									"_id": "q6vdSwTRTwK8EsRQsX0=",
									"_parent": {
										"$ref": "WXnny85AT8Kme+Pbm1Q="
									},
									"name": "Выбор действия со ссылкой",
									"documentation": "Пользователь читает предупреждение и нажимает «Создать ссылку» («Обновить снимок»), «Закрыть доступ» или «Отмена»."
								},
								{
									"_type": "UMLJoinNode",
									"_id": "OnEJkcJ2TU+u4AA6hls=",
									"_parent": {
										"$ref": "WXnny85AT8Kme+Pbm1Q="
									},
									"name": "",
									"documentation": "Узел синхронизации (Join): ожидает завершения параллельных деятельностей «Отображение окна публикации» и «Выбор действия со ссылкой» и только затем передаёт управление дальше."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "QtXFcDhyR8GI/IFAIv0=",
									"_parent": {
										"$ref": "WXnny85AT8Kme+Pbm1Q="
									},
									"name": "",
									"documentation": "Конечное состояние: публикация отменена, ссылка не изменилась."
								}
							],
							"documentation": "Раздел активности (плавательная дорожка) «Пользователь»: состояния, выполняемые исполнителем «Пользователь»."
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "KSF1ZMyfQCqYo/97/X0=",
							"_parent": {
								"$ref": "cYr+3CnIQBSFOkfclII="
							},
							"name": "Система",
							"nodes": [
								{
									"_type": "UMLInitialNode",
									"_id": "Af1AIzNiQq6R+Aus+C4=",
									"_parent": {
										"$ref": "KSF1ZMyfQCqYo/97/X0="
									},
									"name": "",
									"documentation": "Начальное состояние: начало выполнения деятельности «Работа со ссылкой на цепочку»."
								},
								{
									"_type": "UMLAction",
									"_id": "R506CMypRqCOFmLd220=",
									"_parent": {
										"$ref": "KSF1ZMyfQCqYo/97/X0="
									},
									"name": "Отображение окна публикации",
									"documentation": "Система показывает окно публикации: предупреждение «ссылку может открыть любой, у кого она есть», состояние ссылки (нет, действует, дата снимка) и кнопки «Создать ссылку» или «Обновить снимок», «Закрыть доступ», «Отмена». Деятельность выполняется параллельно с выбором и завершается событием «выбрано действие»."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "pBnmrHfJSq2srX/YsUg=",
									"_parent": {
										"$ref": "KSF1ZMyfQCqYo/97/X0="
									},
									"name": "",
									"documentation": "Узел решения: нажата ли «Отмена»."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "OaaWkDNvQLCuIE25Tl4=",
									"_parent": {
										"$ref": "KSF1ZMyfQCqYo/97/X0="
									},
									"name": "",
									"documentation": "Узел решения: создать или обновить ссылку — или закрыть доступ."
								},
								{
									"_type": "UMLAction",
									"_id": "X22NaaHJS0iJevHBBrg=",
									"_parent": {
										"$ref": "KSF1ZMyfQCqYo/97/X0="
									},
									"name": "Создание снимка цепочки без личных данных",
									"documentation": "Система копирует в снимок название, описания, параметры и ключи превью запросов цепочки (без e-mail и идентификатора пользователя). Для новой ссылки генерирует токен 128 бит и хранит только его хэш SHA-256; при обновлении заменяет снимок по тому же адресу."
								},
								{
									"_type": "UMLAction",
									"_id": "CQFBJ65eQbWP6iWRPGg=",
									"_parent": {
										"$ref": "KSF1ZMyfQCqYo/97/X0="
									},
									"name": "Отключение ссылки",
									"documentation": "Система отмечает ссылку отозванной: она проверяется при каждом открытии, поэтому перестаёт работать сразу; копии цепочки, уже сделанные другими пользователями, остаются у них."
								},
								{
									"_type": "UMLAction",
									"_id": "2pRhHkD6REeGhQmFGHI=",
									"_parent": {
										"$ref": "KSF1ZMyfQCqYo/97/X0="
									},
									"name": "Показ ссылки с кнопкой «Копировать»",
									"documentation": "Система показывает адрес /s/<токен> и кнопку «Копировать»; пользователь передаёт ссылку другу."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "wgX5ZzQ6QWqnVD6zmvg=",
									"_parent": {
										"$ref": "KSF1ZMyfQCqYo/97/X0="
									},
									"name": "",
									"documentation": "Конечное состояние: ссылка создана или снимок обновлён."
								},
								{
