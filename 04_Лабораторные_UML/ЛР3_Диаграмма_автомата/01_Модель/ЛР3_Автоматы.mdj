					},
					"name": "Расчёт агрегированных показателей",
					"documentation": "Реализует прецедент «Расчёт агрегированных показателей»: запрос агрегатов за период с переводом долгого расчёта в фоновую очередь и обезличивание результата. Результат — показатели или пустой результат.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "tNCSiLnoR/Kb25TN4sw=",
							"_parent": {
								"$ref": "9tbqLCSzRW+qb7f+dPw="
							},
							"name": "Система",
							"nodes": [
								{
									"_type": "UMLInitialNode",
									"_id": "HJV8l1ClRYS3CraBJgM=",
									"_parent": {
										"$ref": "tNCSiLnoR/Kb25TN4sw="
									},
									"name": "",
									"documentation": "Начальное состояние: начало выполнения деятельности «Расчёт агрегированных показателей»."
								},
								{
									"_type": "UMLAction",
									"_id": "a5vEhYuLRGiyiO/wd08=",
									"_parent": {
										"$ref": "tNCSiLnoR/Kb25TN4sw="
									},
									"name": "Выполнение запроса агрегатов за период",
									"documentation": "Система выполняет через ORM запрос агрегатов (группировка по дням, тарифам, пресетам) к реплике базы только для чтения; запрос ничего не изменяет. Деятельность завершается событием получения результата или истечения 30 секунд."
								},
								{
									"_type": "UMLAction",
									"_id": "ySjJ+JoiSyecqo8Y7h8=",
									"_parent": {
										"$ref": "tNCSiLnoR/Kb25TN4sw="
									},
									"name": "Перевод расчёта в фоновую очередь",
									"documentation": "Система ставит расчёт задачей в очередь cpu и сообщает сотруднику, что отчёт придёт уведомлением."
								},
								{
									"_type": "UMLAction",
									"_id": "+47v3LFnT8+U+jbq6pM=",
									"_parent": {
										"$ref": "tNCSiLnoR/Kb25TN4sw="
									},
									"name": "Ожидание завершения фонового расчёта",
									"documentation": "Система ожидает события завершения фоновой задачи (не дольше 10 минут, затем — сообщение об ошибке)."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "o6884j6AQMiUBhvg3xA=",
									"_parent": {
										"$ref": "tNCSiLnoR/Kb25TN4sw="
									},
									"name": "",
									"documentation": "Узел слияния: объединяет быстрый и фоновый расчёт."
								},
								{
									"_type": "UMLAction",
									"_id": "Yozn4aDwTAuPjICuo8A=",
									"_parent": {
										"$ref": "tNCSiLnoR/Kb25TN4sw="
									},
									"name": "Удаление идентификаторов и e-mail из результата",
									"documentation": "Система удаляет из результата идентификаторы пользователей, e-mail и другие персональные данные; остаются только счётчики и доли."
								},
