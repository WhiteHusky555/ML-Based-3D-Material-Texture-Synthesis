								"$ref": "H9K3IYjuS5eFUOQGaYU="
							},
							"text": "Пополняются база «Материалы» и хранилище S3; учитывается квота тарифа",
							"left": 735,
							"top": 175,
							"width": 180,
							"height": 76
						},
						{
							"_type": "UMLNoteView",
							"_id": "iRGcfindSi2yQMmwaSo=",
							"_parent": {
								"$ref": "H9K3IYjuS5eFUOQGaYU="
							},
							"text": "Ведутся базы «Пользователи и тарифы» и «Пресеты», обновляются веса моделей",
							"left": 975,
							"top": 150,
							"width": 230,
							"height": 60
						},
						{
							"_type": "UMLNoteView",
							"_id": "lSpyzNvMReuwCfoiFo4=",
							"_parent": {
								"$ref": "H9K3IYjuS5eFUOQGaYU="
							},
							"text": "Используются обезличенные данные баз «Материалы» и «Пользователи и тарифы»",
							"left": 735,
							"top": 330,
							"width": 180,
							"height": 76
						},
						{
							"_type": "UMLNoteView",
							"_id": "xZNHRb4aRkmFs0WyEIc=",
							"_parent": {
								"$ref": "H9K3IYjuS5eFUOQGaYU="
							},
							"text": "Используются база «Материалы» и хранилище S3",
							"left": 735,
							"top": 525,
							"width": 180,
							"height": 60
						},
						{
							"_type": "UMLNoteView",
							"_id": "jILhl3q2Sf+x7gJYYMk=",
							"_parent": {
								"$ref": "H9K3IYjuS5eFUOQGaYU="
							},
							"text": "Меняет тариф в базе «Пользователи и тарифы»; от тарифа зависят возможности UC2–UC5",
							"left": 735,
							"top": 605,
							"width": 180,
							"height": 76
						},
						{
