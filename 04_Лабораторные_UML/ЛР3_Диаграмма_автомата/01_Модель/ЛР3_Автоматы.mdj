													"_type": "UMLOpaqueBehavior",
													"_id": "5jjGu6QxT0eole8uJuA=",
													"_parent": {
														"$ref": "gbQYYnWRSimbUjyjMog="
													},
													"name": "Ввод e-mail и пароля"
												}
											],
											"exitActivities": [
												{
													"_type": "UMLOpaqueBehavior",
