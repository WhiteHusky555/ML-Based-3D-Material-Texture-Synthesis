												"$ref": "HRrQk4QIQxOCpX+Ijnk="
											},
											"name": "",
											"kind": "initial",
											"documentation": "Начальное псевдосостояние автомата «Генерация материала»."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "9XE2RdHvR+2LwVYepec=",
											"_parent": {
												"$ref": "HRrQk4QIQxOCpX+Ijnk="
											},
											"name": "",
											"kind": "junction",
											"documentation": "Псевдосостояние соединения: объединяет запуск и возвраты к окну генератора."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "jwDC5D8pS3qhk5QnNxc=",
											"_parent": {
												"$ref": "HRrQk4QIQxOCpX+Ijnk="
											},
											"name": "",
											"kind": "fork",
											"documentation": "Псевдосостояние разветвления: запускает параллельные состояния «Отображение окна генератора» и «Действия пользователя» — окно отображается, пока пользователь работает с ним."
										},
										{
											"_type": "UMLState",
											"_id": "cBn7uF6uQA+r91mgP+U=",
											"_parent": {
												"$ref": "HRrQk4QIQxOCpX+Ijnk="
											},
											"name": "Отображение окна генератора",
											"entryActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "kEoBeQkhRQig12Dolhk=",
													"_parent": {
														"$ref": "cBn7uF6uQA+r91mgP+U="
													},
													"name": "Статус := «новая»"
												}
											],
											"doActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "xU+rcDCxQqO3brxOC4o=",
													"_parent": {
														"$ref": "cBn7uF6uQA+r91mgP+U="
													},
													"name": "Показ окна и реакция на действия"
												}
											],
											"documentation": "Простое состояние: окно отображается системой параллельно с действиями пользователя; внутренняя деятельность потенциально бесконечна, выход только по событию. Окно с лентой запросов цепочки (у каждого результата — номер, код и кнопка «Уточнить»), пресетами, превью шума плиткой 3×3, полем описания и кнопкой «Сгенерировать»; превью обновляется при изменении формы. Деятельности состояния семантически просты, отдельная диаграмма не приводится."
										},
										{
											"_type": "UMLState",
											"_id": "WctI5lCXQUiJRMT3bwQ=",
											"_parent": {
												"$ref": "HRrQk4QIQxOCpX+Ijnk="
											},
											"name": "Действия пользователя",
											"doActivities": [
