														"$ref": "EQCi+bxLSKWu/0idOaQ="
													},
													"name": "Загрузка карт по временным ссылкам"
												}
											],
											"documentation": "Простое состояние: внутренняя деятельность — деятельность ЛР2 «Загрузка карт материала»."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "tbplm+tmRfmDxHyW6CM=",
											"_parent": {
												"$ref": "4XRleX54RrKkOq53jCQ="
											},
											"name": "",
											"kind": "junction",
											"documentation": "Псевдосостояние соединения: объединяет первый показ и возвраты к осмотру материала."
										},
										{
											"_type": "UMLPseudostate",
