				{
					"_type": "UMLActivity",
					"_id": "Qq9HYo4sSk2QZsmMRhE=",
					"_parent": {
						"$ref": "MtH1igEmRYur0xLMrUg="
					},
					"name": "Проверка прав тарифа",
					"documentation": "Реализует прецедент «Проверка прав тарифа»: суточная квота генераций и допустимость параметров (разрешение, шаги, число вариантов, референс) для тарифа пользователя. Результат — права подтверждены (генерация зарезервирована в счётчике) или отказ с пояснением.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "SjbR1RjQTL6Llmm2qK8=",
							"_parent": {
								"$ref": "Qq9HYo4sSk2QZsmMRhE="
							},
							"name": "Система",
							"nodes": [
								{
									"_type": "UMLInitialNode",
									"_id": "oh2CDau3QfazZXiJYSI=",
									"_parent": {
										"$ref": "SjbR1RjQTL6Llmm2qK8="
									},
									"name": "",
									"documentation": "Начальное состояние: начало выполнения деятельности «Проверка прав тарифа»."
								},
								{
									"_type": "UMLAction",
									"_id": "tQb/dS4XQouxNIjVExg=",
									"_parent": {
										"$ref": "SjbR1RjQTL6Llmm2qK8="
									},
									"name": "Получение прав тарифа пользователя",
									"documentation": "Система (API-сервис) берёт тариф из заголовка X-User-Plan и читает права тарифа у сервиса пользователей (GET /internal/plans/{plan}): лимит генераций в сутки, разрешения, шаги, варианты, доступ к референсу."
								},
								{
									"_type": "UMLAction",
									"_id": "ZYOnlH/RSY6QpUKsfQ8=",
									"_parent": {
										"$ref": "SjbR1RjQTL6Llmm2qK8="
									},
									"name": "Чтение суточного счётчика генераций",
									"documentation": "Система читает из таблицы usage_daily число генераций пользователя за текущие сутки (UTC)."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "OU9I361cSDGB60b0xMY=",
									"_parent": {
										"$ref": "SjbR1RjQTL6Llmm2qK8="
									},
									"name": "",
									"documentation": "Узел решения: исчерпана ли суточная квота."
								},
								{
									"_type": "UMLAction",
