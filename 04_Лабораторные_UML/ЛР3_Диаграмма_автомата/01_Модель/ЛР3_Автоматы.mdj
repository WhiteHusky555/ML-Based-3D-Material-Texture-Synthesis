											"_parent": {
												"$ref": "cniQoWH6QkCB7rixRJs="
											},
											"name": "Главное окно",
											"entryActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "n1OGqtQ/Tn+MzPfGNY4=",
