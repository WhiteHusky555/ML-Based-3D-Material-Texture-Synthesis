				{
					"_type": "UMLActivity",
					"_id": "9DhHFTysQCCHM2sfJT0=",
					"_parent": {
						"$ref": "MtH1igEmRYur0xLMrUg="
					},
					"name": "Создание варианта материала",
					"documentation": "Реализует прецедент «Создание варианта материала». Система копирует параметры выбранного материала (шум, пресет, описание, модификаторы, разрешение, seed) в окно генератора, где пользователь меняет их и запускает новую генерацию; исходный материал не изменяется. Деятельность семантически проста, её алгоритм полностью раскрыт в описании, поэтому отдельная диаграмма реализации не приводится."
				},
				{
					"_type": "UMLActivity",
					"_id": "l3vTCHQhRo+N6delpss=",
					"_parent": {
						"$ref": "MtH1igEmRYur0xLMrUg="
					},
					"name": "Работа с историей материалов",
					"documentation": "Алгоритм реализации варианта использования «Работа с историей материалов»: показ списка, открытие, удаление с возвратом к списку, создание варианта.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "HT0dwxobQYqt6OABzWM=",
							"_parent": {
								"$ref": "l3vTCHQhRo+N6delpss="
							},
							"name": "Пользователь",
							"nodes": [
								{
									"_type": "UMLForkNode",
									"_id": "DLZraUO0QA6KGZZUyIE=",
									"_parent": {
										"$ref": "HT0dwxobQYqt6OABzWM="
									},
									"name": "",
									"documentation": "Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Выбор действия с материалом» и «Показ списка материалов» — окно отображается, пока пользователь работает с ним."
								},
								{
									"_type": "UMLAction",
									"_id": "kweHeBAZQ7Wmh4kGxmc=",
									"_parent": {
										"$ref": "HT0dwxobQYqt6OABzWM="
									},
									"name": "Выбор действия с материалом",
									"documentation": "Пользователь просматривает список и выбирает материал или нажимает у материала «Удалить» (с подтверждением в диалоге; при отказе выбор продолжается) или «Изменить параметры», либо закрывает историю."
								},
								{
									"_type": "UMLJoinNode",
									"_id": "JUL7HbySS5C2lOYecRs=",
									"_parent": {
										"$ref": "HT0dwxobQYqt6OABzWM="
									},
									"name": "",
									"documentation": "Узел синхронизации (Join): ожидает завершения параллельных деятельностей «Показ списка материалов» и «Выбор действия с материалом» и только затем передаёт управление дальше."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "ZMvCwOrjTbiV8lAJrA4=",
									"_parent": {
										"$ref": "HT0dwxobQYqt6OABzWM="
									},
									"name": "",
									"documentation": "Конечное состояние: история закрыта."
								}
							],
							"documentation": "Раздел активности (плавательная дорожка) «Пользователь»: состояния, выполняемые исполнителем «Пользователь»."
