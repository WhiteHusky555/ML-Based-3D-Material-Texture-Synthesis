									"_type": "UMLAction",
									"_id": "oTc3CjIYRzuPHqeTOlY=",
									"_parent": {
										"$ref": "PzxOYBugSsiXtLVUlXI="
									},
									"name": "Постановка цепочки задач в очередь",
									"documentation": "API-сервис ставит цепочку Celery noise → generate → upscale → pbr с приоритетом по тарифу (премиум — высокий) в очереди noise, gpu и cpu."
								},
								{
									"_type": "UMLAction",
									"_id": "V5bO2qmlTcW6WxOQ/tM=",
									"_parent": {
										"$ref": "PzxOYBugSsiXtLVUlXI="
									},
									"name": "Освобождение задачи без списания квоты",
									"documentation": "API-сервис помечает задачу «отменена», возвращает резерв квоты и удаляет промежуточные файлы."
								},
								{
									"_type": "UMLAction",
									"_id": "5gFBv27hQZaGRqRSUWI=",
									"_parent": {
										"$ref": "PzxOYBugSsiXtLVUlXI="
									},
									"name": "Фиксация ошибки без списания квоты",
									"documentation": "API-сервис помечает задачу «ошибка», возвращает резерв квоты, записывает подробности в журнал и Sentry, а клиенту отправляет безопасное сообщение о сбое."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "cPCoWNeiR8WC5tPMoTY=",
