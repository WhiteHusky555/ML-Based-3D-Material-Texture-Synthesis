				{
					"_type": "UMLActivity",
					"_id": "tgKphwgxREylwBAbZjo=",
					"_parent": {
						"$ref": "44R2z275SzmtpUeHYGg="
					},
					"name": "Формирование архива материала",
					"documentation": "Реализует прецедент «Формирование архива материала». Система проверяет, что файлы материала есть в хранилище (срок хранения не истёк), собирает ZIP с картами и файлом manifest.json (параметры материала, версии моделей, лицензия по тарифу) и выдаёт временную ссылку S3 на скачивание (срок 15 минут). Деятельность семантически проста, её алгоритм полностью раскрыт в описании, поэтому отдельная диаграмма реализации не приводится."
				},
				{
					"_type": "UMLActivity",
					"_id": "oxW/T23ARmuQP5sltSg=",
					"_parent": {
						"$ref": "44R2z275SzmtpUeHYGg="
					},
					"name": "Экспорт материала",
