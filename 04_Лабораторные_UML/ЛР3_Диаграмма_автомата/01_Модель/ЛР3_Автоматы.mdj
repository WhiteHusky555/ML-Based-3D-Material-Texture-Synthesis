						{
							"_type": "UMLStateMachine",
							"_id": "L2xHmvh1RmChR6FIhTs=",
							"_parent": {
								"$ref": "mfqTSeV3T7Sj1CHhu84="
							},
							"name": "Генерация материала",
							"documentation": "Алгоритм реализации прецедента «Генерация материала» в форме автомата: генератор работает как диалог в цепочке запросов — окно генератора, уточнение предыдущего запроса, проверка прав тарифа, сохранение запроса с номером и кодом, выдача из кэша или обработка задачи (ссылочное состояние на автомат «Обработка задачи генерации»), добавление результата в цепочку и возврат к окну до его закрытия. Внутренние переменные (атрибуты вспомогательного объекта потока управления): Статус (строка) — статус задачи генерации: «новая», «в очереди», «шум», «генерация», «апскейл», «pbr», «готово», «ошибка», «отменена»; Действие (строка) — действие, выбранное в окне: нажатая кнопка, ссылка или закрытие окна.",
							"regions": [
								{
									"_type": "UMLRegion",
									"_id": "Y0IDjgx7RVGNmGoAgPs=",
									"_parent": {
										"$ref": "L2xHmvh1RmChR6FIhTs="
									},
									"vertices": [
										{
											"_type": "UMLPseudostate",
											"_id": "7aW+nxKeSFGysDNxR3A=",
											"_parent": {
												"$ref": "Y0IDjgx7RVGNmGoAgPs="
											},
											"name": "",
											"kind": "initial",
											"documentation": "Начальное псевдосостояние автомата «Генерация материала»."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "jJLXIW3zRMi560qKSn8=",
											"_parent": {
												"$ref": "Y0IDjgx7RVGNmGoAgPs="
											},
											"name": "",
											"kind": "junction",
											"documentation": "Псевдосостояние соединения: объединяет запуск и возвраты к окну генератора."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "jJ8E3j/uTRmaoM+kboM=",
											"_parent": {
												"$ref": "Y0IDjgx7RVGNmGoAgPs="
											},
											"name": "",
											"kind": "fork",
											"documentation": "Псевдосостояние разветвления: запускает параллельные состояния «Отображение окна генератора» и «Действия пользователя» — окно отображается, пока пользователь работает с ним."
										},
										{
											"_type": "UMLState",
											"_id": "/13FLyWQRJ616m7WeEY=",
											"_parent": {
												"$ref": "Y0IDjgx7RVGNmGoAgPs="
											},
											"name": "Отображение окна генератора",
											"entryActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "pKXt0sFuRrSzbKRLFx8=",
													"_parent": {
														"$ref": "/13FLyWQRJ616m7WeEY="
													},
													"name": "Статус := «новая»"
												}
											],
											"doActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "aefryj+vTdu2sHxaHGE=",
													"_parent": {
														"$ref": "/13FLyWQRJ616m7WeEY="
													},
													"name": "Показ окна и реакция на действия"
												}
											],
											"documentation": "Простое состояние: окно отображается системой параллельно с действиями пользователя; внутренняя деятельность потенциально бесконечна, выход только по событию. Окно с лентой запросов цепочки (у каждого результата — номер, код и кнопка «Уточнить»), пресетами, превью шума плиткой 3×3, полем описания и кнопкой «Сгенерировать»; превью обновляется при изменении формы. Деятельности состояния семантически просты, отдельная диаграмма не приводится."
										},
										{
											"_type": "UMLState",
