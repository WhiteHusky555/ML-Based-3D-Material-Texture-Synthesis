								"$ref": "Zvg8k1TnQWO6PN2wCoM="
							},
							"text": "Пополняются база «Материалы» и хранилище S3; учитывается квота тарифа",
							"left": 735,
							"top": 175,
							"width": 180,
							"height": 76
						},
						{
							"_type": "UMLNoteView",
							"_id": "5dVqIZoCTE6zgJ88St4=",
							"_parent": {
								"$ref": "Zvg8k1TnQWO6PN2wCoM="
							},
							"text": "Ведутся базы «Пользователи и тарифы» и «Пресеты», обновляются веса моделей",
							"left": 975,
							"top": 150,
							"width": 230,
							"height": 60
						},
						{
							"_type": "UMLNoteView",
							"_id": "UUtAwXwnRJer1EH1ArM=",
							"_parent": {
								"$ref": "Zvg8k1TnQWO6PN2wCoM="
							},
							"text": "Используются обезличенные данные баз «Материалы» и «Пользователи и тарифы»",
							"left": 735,
							"top": 330,
							"width": 180,
							"height": 76
						},
						{
							"_type": "UMLNoteView",
							"_id": "j5/Gg2gdTsGYLcLetfY=",
							"_parent": {
								"$ref": "Zvg8k1TnQWO6PN2wCoM="
							},
							"text": "Используются база «Материалы» и хранилище S3",
							"left": 735,
							"top": 525,
							"width": 180,
							"height": 60
						},
						{
							"_type": "UMLNoteView",
