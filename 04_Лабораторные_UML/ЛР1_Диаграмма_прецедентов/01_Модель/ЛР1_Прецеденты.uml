<XPD:OBJ name="OwnedElements[6]" type="UMLClass" guid="9pvKGa+8SeeY7NExg/BF2gAA">
<XPD:ATTR name="Name" type="string">Аналитик</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Работник системы (стереотип worker): специалист по анализу данных. Получает агрегированные обезличенные показатели работы сервиса — регистрации, активность и удержание пользователей, конверсию в премиум, статистику генераций — и выгружает отчёты. Доступ только на чтение, персональные данные пользователей ему не показываются. Сотрудник является частью системы, а не сторонней сущностью, поэтому изображён классом со стереотипом worker, а не актором.</XPD:ATTR>
<XPD:ATTR name="StereotypeProfile" type="string">UMLStandard</XPD:ATTR>
<XPD:ATTR name="StereotypeName" type="string">worker</XPD:ATTR>
