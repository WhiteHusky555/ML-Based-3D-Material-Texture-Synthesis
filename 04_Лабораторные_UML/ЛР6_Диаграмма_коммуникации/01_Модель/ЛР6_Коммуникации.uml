<XPD:OBJ name="Triggers[0]" type="UMLCallEvent" guid="oKOLeCB4SGqgjdgX9npjjwAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">vUlx79YZQOyZ+pQmpIcsCQAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
