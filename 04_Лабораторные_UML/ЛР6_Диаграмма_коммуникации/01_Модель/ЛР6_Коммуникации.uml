<XPD:ATTR name="#Views" type="integer">3</XPD:ATTR>
<XPD:REF name="Views[0]">4bYIGXHgRR2h7O8OZoFn/wAA</XPD:REF>
<XPD:REF name="Views[1]">FNULVOWXRuShKDeIuz8y6wAA</XPD:REF>
<XPD:REF name="Views[2]">q0h3v98DTTCqbKWXAEsUPwAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Transitions[1]" type="UMLTransition" guid="zqp60fSjQo6uVVph3DtzsQAA">
<XPD:ATTR name="Documentation" type="string">Стрелка перехода от узла слияния к узлу разветвления не содержит надписей: узел слияния безусловно передаёт управление дальше и обеспечивает единственный вход в следующее состояние.</XPD:ATTR>
<XPD:REF name="StateMachine">9Cy+jTimTzOQFSmo3xdU/AAA</XPD:REF>
<XPD:REF name="Source">c+6B4fOJTLaSw4GMlXc3wwAA</XPD:REF>
