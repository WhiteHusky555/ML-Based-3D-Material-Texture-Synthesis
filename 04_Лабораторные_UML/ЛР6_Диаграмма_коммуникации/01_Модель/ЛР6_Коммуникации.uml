<XPD:REF name="Views[1]">AARML2gWSPSjvLL84wUbTgAA</XPD:REF>
<XPD:REF name="Views[2]">5VauLxpBQdi7OXyREcYTJQAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="zEMSSAGfQRiu8jTZY7tl+QAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">yzXzWi9iSm2PJFJCNdGmBwAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#Effects" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Effects[0]" type="UMLUninterpretedAction" guid="d4C1MxbnQ46MJcSqv7CGogAA">
<XPD:ATTR name="Name" type="string">Действие := выбранное</XPD:ATTR>
