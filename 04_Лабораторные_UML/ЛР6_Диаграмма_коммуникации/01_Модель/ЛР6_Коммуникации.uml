</XPD:OBJ>
<XPD:OBJ name="Subvertices[2]" type="UMLPseudostate" guid="vDA82RJUS5q+Fui755/u0wAA">
<XPD:ATTR name="Documentation" type="string">Псевдосостояние разветвления: запускает параллельные состояния «Отображение панели» и «Действия администратора» — окно отображается, пока пользователь работает с ним.</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkSynchronization</XPD:ATTR>
<XPD:REF name="ContainerState">zOtX61oiSOunVdCTRGWESAAA</XPD:REF>
