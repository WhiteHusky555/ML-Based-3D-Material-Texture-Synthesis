<XPD:REF name="Views[1]">gmWLmWw5R2mcS4s4cRz3FQAA</XPD:REF>
<XPD:REF name="Views[2]">0oFccyeSTkKlXQw33OzigAAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="rQkECQQiRw6cdedQH+eocAAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
