<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">92Mdh7+yRzaTv+cRA6cj4AAA</XPD:REF>
<XPD:ATTR name="#Subvertices" type="integer">21</XPD:ATTR>
