<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">5oi8lK1qS4iik2n5VkKbcQAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
