<XPD:REF name="StateMachine">D1mC8HriTFW4cf9nM8B1vwAA</XPD:REF>
<XPD:ATTR name="#Subvertices" type="integer">20</XPD:ATTR>
<XPD:OBJ name="Subvertices[0]" type="UMLPseudostate" guid="1Vq5cLMITJ2Ve37Nt/+gggAA">
<XPD:ATTR name="Documentation" type="string">Начальное псевдосостояние автомата «Просмотр опубликованной цепочки».</XPD:ATTR>
