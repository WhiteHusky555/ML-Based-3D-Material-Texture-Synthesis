<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">17Of/+2OS8mpw8tKWNfdUwAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">Gw3nCPW0Q3SaHhr8iAKqCAAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Behaviors[2]" type="UMLActivityGraph" guid="7xwT9ocCTDyQ4IDnZVV1MQAA">
<XPD:ATTR name="Name" type="string">Регистрация и вход в систему</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Алгоритм реализации варианта использования «Регистрация и вход в систему»: выбор действия в окне входа, вход по e-mail и паролю, регистрация учётной записи или восстановление пароля; письма подтверждения адреса и сброса пароля доставляет почтовый сервис.</XPD:ATTR>
<XPD:REF name="Context">Pr9n/OgxTRWg7EEDG0ZUAAAA</XPD:REF>
