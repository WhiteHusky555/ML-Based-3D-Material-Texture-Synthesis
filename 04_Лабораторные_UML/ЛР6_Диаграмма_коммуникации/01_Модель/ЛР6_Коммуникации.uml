<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">qzj8gVKiSdKM0APdxT5dTgAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">LgtlXH+VTN+ScNkXqQ7h9AAA</XPD:REF>
</XPD:OBJ>
