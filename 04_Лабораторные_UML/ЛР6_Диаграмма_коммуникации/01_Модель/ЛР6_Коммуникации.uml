<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">vBUx1BH3RmqTWELD+okObAAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">4/lkYtpOQFaYYQIsOhgc/wAA</XPD:REF>
</XPD:OBJ>
