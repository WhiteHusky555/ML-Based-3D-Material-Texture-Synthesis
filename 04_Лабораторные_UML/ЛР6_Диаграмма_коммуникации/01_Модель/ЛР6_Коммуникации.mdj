									"_parent": {
										"$ref": "XysPG0SCSlmcB//IbuA="
									},
									"name": "Резервирование генерации в счётчике",
									"documentation": "Система атомарно увеличивает счётчик usage_daily по ключу идемпотентности запроса (повтор того же запроса не списывает квоту дважды); при отмене или сбое резерв возвращается."
								},
