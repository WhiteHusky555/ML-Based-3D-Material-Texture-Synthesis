											},
											"messageSort": "asynchCall",
											"documentation": "Событие аудита: сервис пользователей пишет его в outbox в одной транзакции с блокировкой; журнал admin-service принимает его через inbox. Асинхронный вызов (отправитель не ждёт завершения обработки) операции ЖурналАудита.Записать() объекта «: ЖурналАудита» объектом «: УправлениеПользователями». Назначение операции: Новая запись журнала. Стрелка с открытым наконечником — асинхронное сообщение.",
											"signature": {
												"$ref": "OCTNDHpTQmWLPveqAx8="
											},
											"name": "Записать",
											"arguments": "сотрудник, действие, данные",
											"connector": {
												"$ref": "LQfQ8HFmS6e+JqccBkc="
											}
										}
