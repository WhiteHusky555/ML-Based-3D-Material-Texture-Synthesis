									"_type": "UMLInitialNode",
									"_id": "gUuBq226RB+O/yZz6PU=",
									"_parent": {
										"$ref": "1AiwztqgSViyPD5+wn8="
									},
									"name": "",
									"documentation": "Начальное состояние: начало выполнения деятельности «Оформление премиум-подписки»."
								},
								{
									"_type": "UMLAction",
									"_id": "4ibq/YdrSda1ngNIjBk=",
									"_parent": {
										"$ref": "1AiwztqgSViyPD5+wn8="
									},
									"name": "Создание платежа и запроса на оплату",
									"documentation": "Система создаёт запись платежа со статусом «ожидает» и ключом идемпотентности и передаёт платёжной системе запрос: сумма, валюта, назначение, идентификатор платежа, адрес возврата."
								},
								{
									"_type": "UMLAction",
									"_id": "N+JBxSVNQT2EgTqIi/A=",
									"_parent": {
										"$ref": "1AiwztqgSViyPD5+wn8="
									},
									"name": "Проверка подписи уведомления",
									"documentation": "Система проверяет подпись уведомления ключом из переменной окружения, сверяет сумму и идентификатор платежа; повторное уведомление того же платежа не обрабатывается дважды."
								},
								{
