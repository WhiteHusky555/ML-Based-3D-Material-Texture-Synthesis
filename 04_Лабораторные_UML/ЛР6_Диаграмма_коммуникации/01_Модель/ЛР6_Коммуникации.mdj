								{
									"_type": "UMLAction",
									"_id": "SzsXfXb/S02xCVxfFn8=",
									"_parent": {
										"$ref": "W1e/eM0WQZ6j4nj+t1Q="
									},
									"name": "Запись результата и событие «готово»",
									"documentation": "API-сервис (одна реплика — по ключу идемпотентности события) записывает ссылки на карты и статус «готово», а реплика с открытым WebSocket клиента пересылает ему событие."
								},
								{
									"_type": "UMLActivityFinalNode",
