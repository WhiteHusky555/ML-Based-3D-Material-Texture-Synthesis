											},
											"name": "версияПеппера",
											"visibility": "private",
											"type": "int",
											"documentation": "Какой версией pepper посчитан хэш (users.pepper_version); меняется только вместе с хэшем. Тип int — целое число (счётчик, номер или размер)."
										},
										{
											"_type": "UMLAttribute",
											"_id": "KEicBaXDTBmFB22KDoE=",
											"_parent": {
												"$ref": "6VVhVZBrRSqWxUUmoAc="
											},
											"name": "роль",
											"visibility": "private",
											"type": "Роль",
											"documentation": "Роль для проверки прав на сервере при каждом запросе."
										},
