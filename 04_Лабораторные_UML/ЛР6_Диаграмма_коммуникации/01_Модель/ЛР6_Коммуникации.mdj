											},
											"target": {
												"$ref": "04wfbsBiREyn3ysBhDk="
											},
											"messageSort": "synchCall",
											"documentation": "Вызов собственной операции УправлениеСеансами.СоздатьСеанс() объектом «: УправлениеСеансами». Назначение операции: Новый сеанс со случайным идентификатором 256 бит.",
											"signature": {
												"$ref": "3TPzlNOASZ+jpVu8acI="
											},
											"name": "СоздатьСеанс",
