				{
					"_type": "UMLActivity",
					"_id": "rmCzPdWaQKeFOeeh0O4=",
					"_parent": {
						"$ref": "LUpKDCiYS4GW2tAwx94="
					},
					"name": "Формирование архива материала",
					"documentation": "Реализует прецедент «Формирование архива материала». Система проверяет, что файлы материала есть в хранилище (срок хранения не истёк), собирает ZIP с картами и файлом manifest.json (параметры материала, версии моделей, лицензия по тарифу) и выдаёт временную ссылку S3 на скачивание (срок 15 минут). Деятельность семантически проста, её алгоритм полностью раскрыт в описании, поэтому отдельная диаграмма реализации не приводится."
				},
				{
					"_type": "UMLActivity",
					"_id": "LAz8QCzqR7WM1hSWMvM=",
					"_parent": {
						"$ref": "LUpKDCiYS4GW2tAwx94="
					},
					"name": "Экспорт материала",
					"documentation": "Алгоритм реализации варианта использования «Экспорт материала»: выбор движка, упаковка карт, преобразования для Unreal Engine и премиум-форматов, формирование архива и скачивание.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "uaQuFb2aR4On7e92oGA=",
							"_parent": {
								"$ref": "LAz8QCzqR7WM1hSWMvM="
							},
							"name": "Пользователь",
							"nodes": [
								{
									"_type": "UMLForkNode",
									"_id": "AlmwVE72TeWh4/DHsKE=",
									"_parent": {
										"$ref": "uaQuFb2aR4On7e92oGA="
									},
									"name": "",
									"documentation": "Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Выбор движка и форматов экспорта» и «Отображение окна экспорта» — окно отображается, пока пользователь работает с ним."
								},
								{
									"_type": "UMLAction",
									"_id": "UBBCn2ysRXyro2bFRMo=",
									"_parent": {
										"$ref": "uaQuFb2aR4On7e92oGA="
									},
									"name": "Выбор движка и форматов экспорта",
									"documentation": "Пользователь выбирает в окне экспорта целевой движок (Blender, Unity или Unreal Engine) и, на тарифе «Премиум», расширенные форматы (16 бит, EXR, .glb)."
								},
								{
									"_type": "UMLJoinNode",
									"_id": "bm9+cofjQ+mDM7522IU=",
									"_parent": {
										"$ref": "uaQuFb2aR4On7e92oGA="
									},
									"name": "",
									"documentation": "Узел синхронизации (Join): ожидает завершения параллельных деятельностей «Отображение окна экспорта» и «Выбор движка и форматов экспорта» и только затем передаёт управление дальше."
								},
								{
									"_type": "UMLAction",
									"_id": "5COMcbafRA6UdDysQL8=",
									"_parent": {
										"$ref": "uaQuFb2aR4On7e92oGA="
									},
									"name": "Скачивание архива по ссылке",
									"documentation": "Браузер пользователя скачивает архив по временной ссылке."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "9mUUPWFjS6yKoSkEdgg=",
									"_parent": {
										"$ref": "uaQuFb2aR4On7e92oGA="
									},
									"name": "",
									"documentation": "Конечное состояние: архив скачан."
								}
							],
							"documentation": "Раздел активности (плавательная дорожка) «Пользователь»: состояния, выполняемые исполнителем «Пользователь»."
						},
