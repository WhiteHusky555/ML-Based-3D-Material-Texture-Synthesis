				{
					"_type": "UMLActivity",
					"_id": "45yIGIDNQOqIzT0tvYk=",
					"_parent": {
						"$ref": "LUpKDCiYS4GW2tAwx94="
					},
					"name": "Пересчёт срока хранения материалов",
					"documentation": "Реализует прецедент «Пересчёт срока хранения материалов». Система обновляет срок хранения всех материалов пользователя по правилам нового тарифа: при оформлении премиума — 90 дней от даты создания, при окончании подписки — 7 дней от даты окончания; обновление выполняется одной транзакцией через ORM и повторяемо без побочных эффектов. Деятельность семантически проста, её алгоритм полностью раскрыт в описании, поэтому отдельная диаграмма реализации не приводится."
				},
				{
					"_type": "UMLActivity",
					"_id": "F76hQ9oGSjKqy8bAoF8=",
					"_parent": {
						"$ref": "LUpKDCiYS4GW2tAwx94="
					},
					"name": "Управление подпиской",
					"documentation": "Алгоритм реализации варианта использования «Управление подпиской»: показ тарифов, оформление премиум-подписки с оплатой или отключение продления с пересчётом сроков хранения.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "3vgCfqsKTvqai8AMRic=",
							"_parent": {
								"$ref": "F76hQ9oGSjKqy8bAoF8="
							},
							"name": "Пользователь",
							"nodes": [
								{
									"_type": "UMLForkNode",
									"_id": "8YqSyrBJRmGfsKe1Bks=",
									"_parent": {
										"$ref": "3vgCfqsKTvqai8AMRic="
									},
									"name": "",
									"documentation": "Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Выбор действия с подпиской» и «Показ тарифов и текущей подписки» — окно отображается, пока пользователь работает с ним."
								},
								{
									"_type": "UMLAction",
									"_id": "dXA3Uf3HTBKHL4FcP3Y=",
									"_parent": {
										"$ref": "3vgCfqsKTvqai8AMRic="
									},
									"name": "Выбор действия с подпиской",
									"documentation": "Пользователь изучает тарифы и нажимает «Оформить Премиум» (если подписки нет) или «Отменить подписку» (если она активна) либо закрывает окно."
								},
								{
									"_type": "UMLJoinNode",
									"_id": "lf3y15O2Qga11WyEXKc=",
									"_parent": {
										"$ref": "3vgCfqsKTvqai8AMRic="
									},
									"name": "",
									"documentation": "Узел синхронизации (Join): ожидает завершения параллельных деятельностей «Показ тарифов и текущей подписки» и «Выбор действия с подпиской» и только затем передаёт управление дальше."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "umeVKhgqQkesoOp/uo4=",
