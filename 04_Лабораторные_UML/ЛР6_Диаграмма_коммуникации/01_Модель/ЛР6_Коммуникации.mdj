				{
					"_type": "UMLActivity",
					"_id": "DcNiVvR5RxuTEk9cI24=",
					"_parent": {
						"$ref": "LUpKDCiYS4GW2tAwx94="
					},
					"name": "Проверка прав тарифа",
					"documentation": "Реализует прецедент «Проверка прав тарифа»: суточная квота генераций и допустимость параметров (разрешение, шаги, число вариантов, референс) для тарифа пользователя. Результат — права подтверждены (генерация зарезервирована в счётчике) или отказ с пояснением.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "XysPG0SCSlmcB//IbuA=",
							"_parent": {
								"$ref": "DcNiVvR5RxuTEk9cI24="
							},
							"name": "Система",
							"nodes": [
								{
									"_type": "UMLInitialNode",
									"_id": "B7G10xl3QlWKAUTSShA=",
									"_parent": {
										"$ref": "XysPG0SCSlmcB//IbuA="
									},
									"name": "",
									"documentation": "Начальное состояние: начало выполнения деятельности «Проверка прав тарифа»."
								},
								{
									"_type": "UMLAction",
									"_id": "JdPV3JJGRFCyuF5UnTQ=",
									"_parent": {
										"$ref": "XysPG0SCSlmcB//IbuA="
									},
									"name": "Получение прав тарифа пользователя",
									"documentation": "Система (API-сервис) берёт тариф из заголовка X-User-Plan и читает права тарифа у сервиса пользователей (GET /internal/plans/{plan}): лимит генераций в сутки, разрешения, шаги, варианты, доступ к референсу."
								},
								{
									"_type": "UMLAction",
									"_id": "smXODd0cSi2xhTAGncY=",
									"_parent": {
										"$ref": "XysPG0SCSlmcB//IbuA="
									},
									"name": "Чтение суточного счётчика генераций",
									"documentation": "Система читает из таблицы usage_daily число генераций пользователя за текущие сутки (UTC)."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "qz3i1OdyQYu30gXKE3E=",
									"_parent": {
										"$ref": "XysPG0SCSlmcB//IbuA="
									},
									"name": "",
									"documentation": "Узел решения: исчерпана ли суточная квота."
								},
								{
									"_type": "UMLAction",
									"_id": "yDkqhjgNQp+Jg0aUNYk=",
									"_parent": {
										"$ref": "XysPG0SCSlmcB//IbuA="
									},
									"name": "Отказ «квота исчерпана»",
									"documentation": "Система формирует ответ 429 с сообщением о лимите и предложением премиум-тарифа; клиент показывает его пользователю."
								},
								{
									"_type": "UMLAction",
									"_id": "ZuL8YJvmTueqELNpa1s=",
									"_parent": {
										"$ref": "XysPG0SCSlmcB//IbuA="
									},
									"name": "Проверка разрешения, шагов, вариантов и референса",
									"documentation": "Система сравнивает запрошенные разрешение, число шагов, число вариантов и наличие референса с правами тарифа."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "OpIG/fNYTUePxdx8Oxg=",
									"_parent": {
										"$ref": "XysPG0SCSlmcB//IbuA="
									},
									"name": "",
									"documentation": "Узел решения: допустимы ли все параметры для тарифа."
								},
								{
									"_type": "UMLAction",
									"_id": "tgB/XnjiQrCucoKoYhM=",
									"_parent": {
										"$ref": "XysPG0SCSlmcB//IbuA="
									},
									"name": "Пометка недоступных параметров «Премиум»",
									"documentation": "Система формирует ответ 403 со списком недоступных параметров; клиент помечает их «доступно в Премиум»."
								},
								{
									"_type": "UMLAction",
