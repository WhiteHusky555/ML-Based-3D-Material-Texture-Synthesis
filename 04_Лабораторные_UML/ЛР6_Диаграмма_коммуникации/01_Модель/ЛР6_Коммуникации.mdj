											},
											"name": "",
											"kind": "fork",
											"documentation": "Псевдосостояние разветвления: запускает параллельные состояния «Отображение списка цепочек» и «Действия пользователя» — окно отображается, пока пользователь работает с ним."
										},
										{
											"_type": "UMLState",
											"_id": "O9LU7nIhRuGy6di3LEI=",
											"_parent": {
												"$ref": "P0c7M8DARNOqKuqUjnw="
											},
											"name": "Отображение списка цепочек",
											"doActivities": [
