						{
							"_type": "UMLStateMachine",
							"_id": "z3qDWjvYRZayzmNwTdM=",
							"_parent": {
								"$ref": "nw2UOtwaQ2e7zJXCBVw="
							},
							"name": "Регистрация и вход в систему",
							"documentation": "Алгоритм реализации прецедента «Регистрация и вход в систему» в форме автомата: окно входа, вход, регистрация или восстановление пароля, отправка письма. Вспомогательные прецеденты представлены состояниями с одноимёнными внутренними деятельностями — их алгоритмы приведены в ЛР2. Внутренние переменные (атрибуты вспомогательного объекта потока управления): Действие (строка) — действие, выбранное в окне: нажатая кнопка, ссылка или закрытие окна.",
							"regions": [
								{
									"_type": "UMLRegion",
									"_id": "YQhh8ovtS8CWSE4NF/Q=",
									"_parent": {
										"$ref": "z3qDWjvYRZayzmNwTdM="
									},
									"vertices": [
										{
											"_type": "UMLPseudostate",
											"_id": "VpqYN2poQEeIxQZU3mM=",
											"_parent": {
												"$ref": "YQhh8ovtS8CWSE4NF/Q="
											},
											"name": "",
											"kind": "initial",
											"documentation": "Начальное псевдосостояние автомата «Регистрация и вход в систему»."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "MnIzycmsSPK2l83aWq8=",
											"_parent": {
												"$ref": "YQhh8ovtS8CWSE4NF/Q="
											},
											"name": "",
											"kind": "fork",
											"documentation": "Псевдосостояние разветвления: запускает параллельные состояния «Отображение окна входа» и «Действия пользователя» — окно отображается, пока пользователь работает с ним."
										},
										{
											"_type": "UMLState",
											"_id": "0YIIKNdqTOuEuJZUXuQ=",
											"_parent": {
												"$ref": "YQhh8ovtS8CWSE4NF/Q="
											},
											"name": "Отображение окна входа",
											"doActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "b7jRuvurSyC6vZrKSf4=",
													"_parent": {
														"$ref": "0YIIKNdqTOuEuJZUXuQ="
													},
													"name": "Показ окна и реакция на действия"
												}
											],
											"documentation": "Простое состояние: окно отображается системой параллельно с действиями пользователя; внутренняя деятельность потенциально бесконечна, выход только по событию. Окно с полями e-mail и пароль, кнопкой «Войти» и ссылками «Зарегистрироваться» и «Забыли пароль?». Деятельности состояния семантически просты, отдельная диаграмма не приводится."
										},
										{
											"_type": "UMLState",
											"_id": "sx9fJC0/SfGvyuM6w9k=",
											"_parent": {
												"$ref": "YQhh8ovtS8CWSE4NF/Q="
											},
											"name": "Действия пользователя",
											"doActivities": [
