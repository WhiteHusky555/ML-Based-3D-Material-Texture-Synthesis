											}
										},
										{
											"_type": "UMLMessage",
											"_id": "H3rdMMwrQ3KZDkJVhac=",
											"_parent": {
												"$ref": "8Sbt1N1ORyuq5xLPE84="
											},
											"source": {
												"$ref": "gtB4cbU7S9ywTb4cT34="
											},
											"target": {
												"$ref": "1uRYuTjwQzqeUFzesio="
											},
											"messageSort": "synchCall",
											"documentation": "Синхронный вызов операции Пользователь.Заблокировать() объекта «учётнаяЗапись: Пользователь» объектом «: УправлениеПользователями». Назначение операции: Блокировка администратором (переход в «Заблокирована») с отзывом всех токенов. Результата нет (None): операция только изменяет состояние.",
											"signature": {
												"$ref": "1v1aT5EFQvWKE5nthWA="
											},
											"name": "Заблокировать",
											"connector": {
