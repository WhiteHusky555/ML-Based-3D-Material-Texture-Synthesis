					"_type": "UMLActivity",
					"_id": "DMAIYJuHSR2a0jDkwEc=",
					"_parent": {
						"$ref": "LUpKDCiYS4GW2tAwx94="
					},
					"name": "Администрирование системы",
					"documentation": "Алгоритм реализации варианта использования «Администрирование системы»: выбор раздела панели (пользователи, пресеты, модели, мониторинг), выполнение операции, запись изменений в журнал аудита.",
					"groups": [
