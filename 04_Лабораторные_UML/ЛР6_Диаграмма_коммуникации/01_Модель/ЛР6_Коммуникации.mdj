													"_type": "UMLOpaqueBehavior",
													"_id": "H7Q/DPKsQseFEuUYADE=",
													"_parent": {
														"$ref": "sx9fJC0/SfGvyuM6w9k="
													},
													"name": "Ввод e-mail и пароля"
												}
											],
											"exitActivities": [
