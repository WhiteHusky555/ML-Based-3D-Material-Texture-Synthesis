<XPD:ATTR name="Documentation" type="string">Начальное псевдосостояние автомата «Просмотр материала в 3D».</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkInitial</XPD:ATTR>
