<XPD:REF name="Outgoings[0]">PnhgSowURJ+2Oh0hZlPYmAAA</XPD:REF>
<XPD:ATTR name="#Incomings" type="integer">1</XPD:ATTR>
<XPD:REF name="Incomings[0]">DbXbJjQ2RrOUK0c+izAs1AAA</XPD:REF>
<XPD:ATTR name="#DoActivities" type="integer">1</XPD:ATTR>
<XPD:OBJ name="DoActivities[0]" type="UMLUninterpretedAction" guid="YpPKQkTbTyqsaVozMOJnKwAA">
<XPD:ATTR name="Name" type="string">Показ предупреждения и состояния ссылки</XPD:ATTR>
<XPD:REF name="DoActivityState">8nN0wWVrQBSKUvGqbqRP7wAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
<XPD:OBJ name="Subvertices[3]" type="UMLCompositeState" guid="YctK2flvScim3hdV/2L4UQAA">
<XPD:ATTR name="Name" type="string">Действия пользователя</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Простое состояние: действия в окне, выполняемые параллельно с его отображением; внутренние деятельности do выполняются в любом порядке, состояние завершается действием exit. Пользователь читает предупреждение и нажимает одну из кнопок. Деятельности состояния семантически просты, отдельная диаграмма не приводится.</XPD:ATTR>
<XPD:REF name="ContainerState">/GXXcY5GR+OaK4Y6lM6NJAAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">2</XPD:ATTR>
