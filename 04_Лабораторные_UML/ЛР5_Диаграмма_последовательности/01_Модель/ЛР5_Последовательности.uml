<XPD:OBJ name="DoActivities[0]" type="UMLUninterpretedAction" guid="IOwXQilDR7GjsE2FCujFUQAA">
<XPD:ATTR name="Name" type="string">Задание формы материала</XPD:ATTR>
<XPD:REF name="DoActivityState">p5K+9P23T4auJupKs+yq5QAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="DoActivities[1]" type="UMLUninterpretedAction" guid="OWqehkEiTkCmruyX1BuYeAAA">
