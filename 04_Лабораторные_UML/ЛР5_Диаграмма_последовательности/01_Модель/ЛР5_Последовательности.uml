<XPD:ATTR name="DirectionKind" type="UMLParameterDirectionKind">pdkReturn</XPD:ATTR>
<XPD:ATTR name="TypeExpression" type="string">Пользователь</XPD:ATTR>
<XPD:REF name="BehavioralFeature">h+4xiXoVQ8iGfWmDD1GI7wAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
<XPD:OBJ name="Operations[1]" type="UMLOperation" guid="8VctL0ptS/2jshzEX3dhhAAA">
<XPD:ATTR name="Name" type="string">ПроверитьРоль</XPD:ATTR>
<XPD:ATTR name="Visibility" type="UMLVisibilityKind">vkPublic</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Есть ли у учётной записи нужная роль. Параметры: пользователь — объект класса «Пользователь»; роль — перечисление «Роль» (допустимы только его значения); результат bool — логическое значение «да/нет».</XPD:ATTR>
<XPD:REF name="Owner">e8uG4ERNQhiOZPCxP9Te0QAA</XPD:REF>
