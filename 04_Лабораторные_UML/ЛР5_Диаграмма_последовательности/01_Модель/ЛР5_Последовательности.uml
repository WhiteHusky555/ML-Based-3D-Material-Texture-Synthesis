<XPD:ATTR name="Name" type="string">Работа со ссылкой на цепочку</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Набор экземпляров взаимодействия «Работа со ссылкой на цепочку».</XPD:ATTR>
<XPD:REF name="RepresentedClassifier">Zg/y6sOOR4iAu+xaUzyYSgAA</XPD:REF>
<XPD:ATTR name="#InteractionInstanceSets" type="integer">1</XPD:ATTR>
