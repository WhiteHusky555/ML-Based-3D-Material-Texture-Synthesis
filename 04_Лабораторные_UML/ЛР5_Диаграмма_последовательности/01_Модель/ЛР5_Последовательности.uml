<XPD:ATTR name="#Views" type="integer">3</XPD:ATTR>
<XPD:REF name="Views[0]">4LSEt4+qQWq9r3KXTSTT8QAA</XPD:REF>
<XPD:REF name="Views[1]">MwseJbpiRNOmfVJHWPauQgAA</XPD:REF>
<XPD:REF name="Views[2]">UMu9GGSmRZCefOwUX6WnHAAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="ParticipatingStimuli[2]" type="UMLStimulus" guid="Q+vVHkFESAeVUp4sRN9DeAAA">
<XPD:ATTR name="Arguments" type="string">параметры</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Параметры выбранного запроса или шага предыстории переносятся в поля окна; следующий запрос сошлётся на выбранный. Вызов собственной операции ОкноГенератора.ВзятьПараметры() объектом «: ОкноГенератора». Назначение операции: Уточнение: параметры выбранного запроса или шага предыстории переносятся в поля окна.</XPD:ATTR>
<XPD:REF name="Sender">iTCZ/GT2RpyUKM9ufJAfWgAA</XPD:REF>
<XPD:REF name="Receiver">iTCZ/GT2RpyUKM9ufJAfWgAA</XPD:REF>
<XPD:OBJ name="Action" type="UMLCallAction" guid="fDhDr68jR7W2DhXBG1lYjQAA">
<XPD:REF name="Stimulus">Q+vVHkFESAeVUp4sRN9DeAAA</XPD:REF>
<XPD:REF name="Operation">yxTgfPeLSkSiAtKkhZSS+QAA</XPD:REF>
</XPD:OBJ>
<XPD:REF name="InteractionInstanceSet">i97kwYiHQUaH4wIdG5GE4wAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">3</XPD:ATTR>
