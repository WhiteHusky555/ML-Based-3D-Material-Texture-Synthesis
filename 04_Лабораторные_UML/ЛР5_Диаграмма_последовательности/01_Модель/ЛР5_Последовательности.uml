</XPD:OBJ>
<XPD:OBJ name="Subvertices[1]" type="UMLCompositeState" guid="Mu78lO1jQTqzKQzB/9IM2wAA">
<XPD:ATTR name="Name" type="string">Проверка роли</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Простое состояние: сервер читает роль учётной записи из базы при каждом запросе; роль owner обязательна. Деятельности состояния семантически просты, отдельная диаграмма не приводится.</XPD:ATTR>
