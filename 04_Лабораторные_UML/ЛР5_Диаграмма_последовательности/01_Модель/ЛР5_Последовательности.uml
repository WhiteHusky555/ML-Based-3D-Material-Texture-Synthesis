<XPD:ATTR name="Documentation" type="string">Начальное состояние: начало выполнения деятельности «Регистрация и вход в систему».</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkInitial</XPD:ATTR>
<XPD:REF name="ContainerState">xmkddQEqTrufP99E/j7TxQAA</XPD:REF>
