<XPD:OBJ name="Behaviors[32]" type="UMLActivityGraph" guid="y9yJB89wQmyA3PfPXHB82wAA">
<XPD:ATTR name="Name" type="string">Расчёт агрегированных показателей</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Реализует прецедент «Расчёт агрегированных показателей»: запрос агрегатов за период с переводом долгого расчёта в фоновую очередь и обезличивание результата. Результат — показатели или пустой результат.</XPD:ATTR>
<XPD:REF name="Context">VCFkwam1RnKjcnb+iJO2DwAA</XPD:REF>
<XPD:OBJ name="Top" type="UMLCompositeState" guid="ZJQtqSC9TdiBsLj9ewxP+wAA">
<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">y9yJB89wQmyA3PfPXHB82wAA</XPD:REF>
<XPD:ATTR name="#Subvertices" type="integer">11</XPD:ATTR>
<XPD:OBJ name="Subvertices[0]" type="UMLPseudostate" guid="7LwXnru6RiS1UDXyPzW1TgAA">
<XPD:ATTR name="Documentation" type="string">Начальное состояние: начало выполнения деятельности «Расчёт агрегированных показателей».</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkInitial</XPD:ATTR>
<XPD:REF name="ContainerState">ZJQtqSC9TdiBsLj9ewxP+wAA</XPD:REF>
