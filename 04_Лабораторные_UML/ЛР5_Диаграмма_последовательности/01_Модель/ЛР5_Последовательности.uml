<XPD:ATTR name="Documentation" type="string">Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Отображение окна входа» и «Выбор действия в окне входа» — окно отображается, пока пользователь работает с ним.</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkSynchronization</XPD:ATTR>
<XPD:REF name="ContainerState">Xqo+iCPVQxiWslVRp6JSawAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">1</XPD:ATTR>
<XPD:REF name="Views[0]">xxKYlHsZRaeG6WrmFPF4JAAA</XPD:REF>
<XPD:ATTR name="#OwnerPartitions" type="integer">1</XPD:ATTR>
