<XPD:OBJ name="DoActivities[0]" type="UMLUninterpretedAction" guid="G51tv9T3T46RFMCi8+1IUgAA">
<XPD:ATTR name="Name" type="string">Показ окна и реакция на действия</XPD:ATTR>
<XPD:REF name="DoActivityState">0CshkahDTmGyTc11mD8e+gAA</XPD:REF>
