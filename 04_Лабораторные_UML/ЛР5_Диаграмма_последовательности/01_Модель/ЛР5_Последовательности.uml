<XPD:REF name="Views[2]">j19w4kB+Ru+z8kSdjDfbfwAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="bXWlzj9kQ9ON3+3epx8KzgAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">C7pq4ywwQ9OuyWczvIRVvwAA</XPD:REF>
</XPD:OBJ>
