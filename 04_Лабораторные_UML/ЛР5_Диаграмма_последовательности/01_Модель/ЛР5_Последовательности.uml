<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">6roOM837S1CAl9b6rQvBPwAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
