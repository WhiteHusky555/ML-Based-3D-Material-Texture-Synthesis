<XPD:REF name="OwnerPartitions[0]">rAF1FZQCQX2PbedNlQwuygAA</XPD:REF>
<XPD:ATTR name="#Outgoings" type="integer">1</XPD:ATTR>
<XPD:REF name="Outgoings[0]">sm/wB7sFQ0q+lJlW7BX9IwAA</XPD:REF>
<XPD:ATTR name="#Incomings" type="integer">1</XPD:ATTR>
<XPD:REF name="Incomings[0]">PPvb9l6/Roe/Ll+XiBZGYwAA</XPD:REF>
</XPD:OBJ>
