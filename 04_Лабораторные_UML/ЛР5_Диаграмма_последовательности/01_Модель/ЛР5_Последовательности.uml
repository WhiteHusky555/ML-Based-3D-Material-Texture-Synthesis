<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="AkQCwx1GSZqmw03zxmD3cwAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">5m1qveV2Tza9f4XerS2QlgAA</XPD:REF>
</XPD:OBJ>
