<XPD:ATTR name="#Incomings" type="integer">1</XPD:ATTR>
<XPD:REF name="Incomings[0]">qjBaOoTaTgagvwNjMbPfJQAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Subvertices[2]" type="UMLPseudostate" guid="TsK5G+K7ShyVsqQE49ixlAAA">
<XPD:ATTR name="Documentation" type="string">Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Ввод платёжных данных» и «Показ страницы оплаты» — окно отображается, пока пользователь работает с ним.</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkSynchronization</XPD:ATTR>
<XPD:REF name="ContainerState">LGGkfd8zTc2EbLZXmX7osgAA</XPD:REF>
