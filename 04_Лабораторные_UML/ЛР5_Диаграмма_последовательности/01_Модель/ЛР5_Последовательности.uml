<XPD:ATTR name="#Views" type="integer">3</XPD:ATTR>
<XPD:REF name="Views[0]">xb8dbB+IQS2JILNpIXd0hQAA</XPD:REF>
<XPD:REF name="Views[1]">cLeyo3qlQIepjTA5o0m49gAA</XPD:REF>
<XPD:REF name="Views[2]">zhpaOmRPQwq8L0Qs4/bNugAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Transitions[2]" type="UMLTransition" guid="XhIE4n50Q/GX0iJXI42TvAAA">
<XPD:ATTR name="Documentation" type="string">Над стрелкой перехода из «Отображение окна входа» в псевдосостояние синхронизации указаны: событие «выбрано действие», действие на переходе «Действие := выбранное»; внутренняя деятельность состояния «Отображение окна входа» — отображение окна параллельно с действиями пользователя — потенциально бесконечна, поэтому выход из него возможен только по событию; псевдосостояние синхронизации передаёт управление дальше, когда завершатся и действия пользователя; действие выполняется при переходе и изменяет внутреннюю переменную или состояние объекта.</XPD:ATTR>
<XPD:REF name="StateMachine">a5vLVBKMTCuJGpZ5o4dbgAAA</XPD:REF>
<XPD:REF name="Source">Fxc6RMGJRR6G/ljcz2B10wAA</XPD:REF>
<XPD:REF name="Target">eJ30XPshQ6iFF7GieGZzhgAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">3</XPD:ATTR>
<XPD:REF name="Views[0]">bfbayTQ8RD2rUaasszaRiQAA</XPD:REF>
<XPD:REF name="Views[1]">nuO8Mnc6TCCw2iNFnyPZ5AAA</XPD:REF>
<XPD:REF name="Views[2]">T5ZJ5lX6QCiK9msekRjGhQAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="idpZ9T0hT7K1jfqNqq4JwAAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">XhIE4n50Q/GX0iJXI42TvAAA</XPD:REF>
</XPD:OBJ>
