<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">Q0RH6ZCLRZCACFFPdIMOKwAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">2</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">25729PcZQRiX2dXc7lDWEAAA</XPD:REF>
<XPD:REF name="SubmachineStates[1]">K1fa4GrPS/+9J/PrEiFdvAAA</XPD:REF>
</XPD:OBJ>
