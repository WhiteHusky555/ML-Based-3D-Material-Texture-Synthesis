</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">diCnfXj6QECZzeWPxNaaGgAA</XPD:REF>
</XPD:OBJ>
