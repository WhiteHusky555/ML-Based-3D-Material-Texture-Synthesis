<XPD:OBJ name="Effects[0]" type="UMLUninterpretedAction" guid="xBr10JGSRY+vyIozO9ZSXQAA">
<XPD:ATTR name="Name" type="string">Действие := выбранное</XPD:ATTR>
<XPD:REF name="Transition">XhIE4n50Q/GX0iJXI42TvAAA</XPD:REF>
