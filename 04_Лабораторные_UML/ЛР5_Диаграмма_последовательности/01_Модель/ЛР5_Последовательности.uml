<XPD:REF name="Outgoings[0]">CveQpI4LSDCxH7CS09sqWgAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Subvertices[1]" type="UMLPseudostate" guid="rSzfCyM8RcaPO23oLZ1g5gAA">
<XPD:ATTR name="Documentation" type="string">Псевдосостояние разветвления: запускает параллельные состояния «Отображение окна тарифов» и «Действия пользователя» — окно отображается, пока пользователь работает с ним.</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkSynchronization</XPD:ATTR>
<XPD:REF name="ContainerState">AajctRt9RYW0YWUUBJbPpgAA</XPD:REF>
