											},
											"name": "входЗаблокированДо",
											"visibility": "private",
											"type": "datetime",
											"documentation": "Окончание временной блокировки входа; пусто, если вход разрешён. Тип datetime — дата и время в UTC (момент события)."
										},
										{
											"_type": "UMLAttribute",
