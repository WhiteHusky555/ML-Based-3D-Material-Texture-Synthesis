									"messages": [
										{
											"_type": "UMLMessage",
											"_id": "Q/ytK5KJS6i0/nXDSbk=",
											"_parent": {
												"$ref": "ZsF+dmfvSNiHCdmRYmA="
											},
											"source": {
												"$ref": "AB4J3ISYQsmQ/N221vM="
											},
											"target": {
												"$ref": "9DOVY4lYSCCC/BN2r6o="
											},
											"messageSort": "asynchCall",
											"documentation": "Команда «назначить роль» от staff-ui через RabbitMQ (обмен commands), обработка через inbox. Асинхронный вызов (отправитель не ждёт завершения обработки) операции УправлениеРолями.НазначитьРоль() объекта «: УправлениеРолями» объектом «: ПанельВладельца». Назначение операции: Пользователь.НазначитьРоль() и запись в журнал. Стрелка с открытым наконечником — асинхронное сообщение.",
											"signature": {
												"$ref": "XGmUIWhpQfywVMArRDs="
											},
											"name": "НазначитьРоль",
											"arguments": "email, роль"
										},
										{
											"_type": "UMLMessage",
											"_id": "zKTPT3JKTPyyd5N8BUw=",
											"_parent": {
												"$ref": "ZsF+dmfvSNiHCdmRYmA="
											},
											"source": {
												"$ref": "9DOVY4lYSCCC/BN2r6o="
											},
											"target": {
												"$ref": "1YxACnSLSLCNdz5DFn4="
											},
											"messageSort": "synchCall",
											"documentation": "Синхронный вызов операции Пользователь.НазначитьРоль() объекта «сотрудник: Пользователь» объектом «: УправлениеРолями». Назначение операции: Новая роль действует со следующего запроса; выданные токены отзываются.",
											"signature": {
												"$ref": "tZRlzK80RZuIksgoeD0="
											},
											"name": "НазначитьРоль",
											"arguments": "роль"
										},
										{
											"_type": "UMLMessage",
											"_id": "l1h9TxPATku6PI3gA4k=",
											"_parent": {
												"$ref": "ZsF+dmfvSNiHCdmRYmA="
											},
											"source": {
												"$ref": "1YxACnSLSLCNdz5DFn4="
											},
											"target": {
												"$ref": "1YxACnSLSLCNdz5DFn4="
											},
											"messageSort": "synchCall",
											"documentation": "Новая роль действует со следующего запроса. Вызов собственной операции Пользователь.ОтозватьТокены() объектом «сотрудник: Пользователь». Назначение операции: Увеличивает версию токенов; вызывается блокировкой, сменой пароля и роли. Результата нет (None): операция только изменяет состояние. Закрытая (-): вспомогательный шаг, вызывается только внутри класса.",
											"signature": {
												"$ref": "oK/DlsPYTjCoM4q1Mzk="
											},
											"name": "ОтозватьТокены"
										},
										{
											"_type": "UMLMessage",
											"_id": "QVqOscx/RBeKU4Mt9Gs=",
											"_parent": {
												"$ref": "ZsF+dmfvSNiHCdmRYmA="
											},
											"source": {
												"$ref": "9DOVY4lYSCCC/BN2r6o="
											},
											"target": {
												"$ref": "S9DMjSp8RxG9YQLVZ3c="
											},
											"messageSort": "asynchCall",
											"documentation": "Событие аудита через outbox в одной транзакции с назначением; журнал admin-service — через inbox. Асинхронный вызов (отправитель не ждёт завершения обработки) операции ЖурналАудита.Записать() объекта «: ЖурналАудита» объектом «: УправлениеРолями». Назначение операции: Новая запись журнала. Стрелка с открытым наконечником — асинхронное сообщение.",
											"signature": {
												"$ref": "pi2iWP4aSFSjuf/cSn8="
											},
											"name": "Записать",
											"arguments": "сотрудник, действие, данные"
										}
