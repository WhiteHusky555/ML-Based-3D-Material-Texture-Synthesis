											"_parent": {
												"$ref": "aHiZgrIARQ2XKGKylM4="
											},
											"name": "",
											"kind": "junction",
											"documentation": "Псевдосостояние соединения: объединяет первый показ и возвраты к осмотру материала."
										},
										{
											"_type": "UMLPseudostate",
