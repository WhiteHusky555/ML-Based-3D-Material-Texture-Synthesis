									},
									"vertices": [
										{
											"_type": "UMLPseudostate",
											"_id": "yP51PEwhQWq6ehFXPyc=",
											"_parent": {
												"$ref": "cz4gs4TXSU2C3HjXPsU="
											},
											"name": "",
