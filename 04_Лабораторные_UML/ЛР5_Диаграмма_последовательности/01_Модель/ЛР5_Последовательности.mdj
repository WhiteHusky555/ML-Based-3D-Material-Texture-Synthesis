							"ownedElements": [
								{
									"_type": "UMLInteraction",
									"_id": "6Rt1dLR4QbqwMTm+XjU=",
									"_parent": {
										"$ref": "tt0gwKBNSP69GbDt+Kk="
									},
									"name": "Работа со ссылкой на цепочку",
									"documentation": "Реализация прецедента «Работа со ссылкой на цепочку» (UC11): снимок цепочки без личных данных, новая ссылка или обновление снимка по прежнему адресу, отзыв ссылки; ссылку пользователь передаёт гостю сам. Окно публикации открывает окно истории по кнопке «Поделиться» (диаграмма SD_Request_History, фрагмент ref).",
									"participants": [
										{
											"_type": "UMLLifeline",
											"_id": "nLXW0bkISLyUJ7OdV20=",
											"_parent": {
												"$ref": "6Rt1dLR4QbqwMTm+XjU="
											},
											"name": "",
											"represent": {
												"$ref": "V2z2TgNYQDe+gTSq2yc="
											},
											"documentation": "Линия жизни: актор «Пользователь» (ЛР1). Читает предупреждение и выбирает кнопку окна публикации."
										},
										{
											"_type": "UMLLifeline",
											"_id": "5z/vzFW4Q02LbR67GcI=",
											"_parent": {
												"$ref": "6Rt1dLR4QbqwMTm+XjU="
											},
											"name": "",
											"represent": {
												"$ref": "zZHHmyJETaS4vCQyQac="
											},
											"documentation": "Линия жизни: анонимный объект класса «ОкноПубликации» (граничный класс). Где работает: веб-клиент (браузер, React); запросы идут в web-bff. Открыто окном истории по кнопке «Поделиться».",
											"stereotype": "boundary"
										},
										{
											"_type": "UMLLifeline",
											"_id": "WZdCTyB3TrCU+lPs518=",
											"_parent": {
												"$ref": "6Rt1dLR4QbqwMTm+XjU="
											},
											"name": "",
											"represent": {
												"$ref": "9K+QC+b4QfSbNLIrvkg="
											},
											"documentation": "Линия жизни: анонимный объект класса «КонтроллерПубликации» (управляющий класс). Где работает: API-сервис (PostgreSQL, схема core).",
											"stereotype": "control"
										},
										{
											"_type": "UMLLifeline",
											"_id": "fEGkC0rXRNCtM/+dFdQ=",
											"_parent": {
												"$ref": "6Rt1dLR4QbqwMTm+XjU="
											},
											"name": "ссылка",
											"represent": {
												"$ref": "uW/8YerSTHCT8S5L0fc="
											},
											"documentation": "Линия жизни: объект «ссылка» класса «ПубличнаяСсылка» (класс-сущность). Где работает: API-сервис (PostgreSQL, схема core). Создаётся при первой публикации; токен хранится только хэшем SHA-256.",
											"stereotype": "entity"
										}
									],
									"messages": [
										{
											"_type": "UMLMessage",
											"_id": "gwYRMaorSxy3aO7gSEI=",
											"_parent": {
												"$ref": "6Rt1dLR4QbqwMTm+XjU="
											},
											"source": {
												"$ref": "nLXW0bkISLyUJ7OdV20="
											},
											"target": {
												"$ref": "5z/vzFW4Q02LbR67GcI="
											},
											"messageSort": "synchCall",
											"documentation": "Пользователь нажимает кнопку окна публикации. Действие актора «: Пользователь»: вызов операции ОкноПубликации.ВыбранноеДействие() окна «: ОкноПубликации». Назначение операции: Создать ссылку, закрыть доступ или отмена.",
											"signature": {
												"$ref": "oNV8bqF0T3yyZXSRbRs="
											},
											"name": "ВыбранноеДействие"
										},
										{
											"_type": "UMLMessage",
											"_id": "f7XlrGAJRjK9/CIx238=",
											"_parent": {
												"$ref": "6Rt1dLR4QbqwMTm+XjU="
											},
											"source": {
												"$ref": "5z/vzFW4Q02LbR67GcI="
											},
											"target": {
												"$ref": "WZdCTyB3TrCU+lPs518="
											},
											"messageSort": "asynchCall",
											"documentation": "Команда «опубликовать»: POST /bff/chains/{id}/share, web-bff публикует её в RabbitMQ (обмен commands) и сразу отвечает окну 202 (решение 13.11.2026). Асинхронный вызов (отправитель не ждёт завершения обработки) операции КонтроллерПубликации.Опубликовать() объекта «: КонтроллерПубликации» объектом «: ОкноПубликации». Назначение операции: Снимок цепочки из её запросов; первая публикация создаёт ссылку и возвращает адрес /s/<токен>; при действующей ссылке снимок обновляется по прежнему адресу и возвращается None. Стрелка с открытым наконечником — асинхронное сообщение.",
											"signature": {
												"$ref": "DwZjM+49T3ucYx2eQDs="
											},
											"name": "Опубликовать",
											"arguments": "цепочка"
										},
										{
											"_type": "UMLMessage",
											"_id": "Qr9SJC5zS/W/xcn1p3Y=",
											"_parent": {
												"$ref": "6Rt1dLR4QbqwMTm+XjU="
											},
											"source": {
												"$ref": "WZdCTyB3TrCU+lPs518="
											},
											"target": {
												"$ref": "WZdCTyB3TrCU+lPs518="
											},
											"messageSort": "synchCall",
											"documentation": "В шаг снимка попадают описание, параметры, код запроса и карты — личных данных нет. Вызов собственной операции КонтроллерПубликации.СобратьШаг() объектом «: КонтроллерПубликации». Назначение операции: Что попадает в снимок, решается только здесь: описание, параметры, код запроса, ключ миниатюры и карты материала.",
											"signature": {
												"$ref": "vyn8wVm+T8miZJuFuls="
											},
											"name": "СобратьШаг",
											"arguments": "запрос, материал"
										},
										{
											"_type": "UMLMessage",
											"_id": "8E0J1O5UQiaRSmAlonc=",
