				{
					"_type": "UMLActivity",
					"_id": "CN237eZcS32G8ymsDZs=",
					"_parent": {
						"$ref": "5UajWf21RUSoa8Fo64M="
					},
					"name": "Пересчёт срока хранения материалов",
					"documentation": "Реализует прецедент «Пересчёт срока хранения материалов». Система обновляет срок хранения всех материалов пользователя по правилам нового тарифа: при оформлении премиума — 90 дней от даты создания, при окончании подписки — 7 дней от даты окончания; обновление выполняется одной транзакцией через ORM и повторяемо без побочных эффектов. Деятельность семантически проста, её алгоритм полностью раскрыт в описании, поэтому отдельная диаграмма реализации не приводится."
				},
				{
					"_type": "UMLActivity",
					"_id": "pPqiXQ5cRXyNNjSumkk=",
					"_parent": {
						"$ref": "5UajWf21RUSoa8Fo64M="
					},
					"name": "Управление подпиской",
