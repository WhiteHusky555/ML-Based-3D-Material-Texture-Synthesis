				{
					"_type": "UMLActivity",
					"_id": "AV9i4yboTSKg1owCLzk=",
					"_parent": {
						"$ref": "5UajWf21RUSoa8Fo64M="
					},
					"name": "Оформление премиум-подписки",
					"documentation": "Реализует прецедент «Оформление премиум-подписки» вместе с включаемым «Оплата подписки»: платёж через платёжную систему, активация подписки только по подписанному уведомлению (webhook), пересчёт сроков хранения. Если уведомление не пришло за 15 минут, система сама запрашивает статус платежа.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "0AEMTFzmQk2Z9uBcZ3Y=",
							"_parent": {
								"$ref": "AV9i4yboTSKg1owCLzk="
							},
							"name": "Пользователь",
							"nodes": [
								{
									"_type": "UMLForkNode",
									"_id": "EpHL7Ph1QBqCoQoC8xc=",
									"_parent": {
										"$ref": "0AEMTFzmQk2Z9uBcZ3Y="
									},
									"name": "",
									"documentation": "Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Ввод платёжных данных» и «Показ страницы оплаты» — окно отображается, пока пользователь работает с ним."
								},
								{
									"_type": "UMLAction",
									"_id": "P97s6XB5SH++ii3eAYs=",
									"_parent": {
										"$ref": "0AEMTFzmQk2Z9uBcZ3Y="
									},
									"name": "Ввод платёжных данных",
									"documentation": "Пользователь вводит платёжные данные в поля отображаемой страницы платёжной системы и подтверждает оплату."
								},
								{
									"_type": "UMLJoinNode",
									"_id": "0BFquJk7RFqOY2lTOuk=",
									"_parent": {
										"$ref": "0AEMTFzmQk2Z9uBcZ3Y="
									},
									"name": "",
									"documentation": "Узел синхронизации (Join): ожидает завершения параллельных деятельностей «Показ страницы оплаты» и «Ввод платёжных данных» и только затем передаёт управление дальше."
								}
							],
							"documentation": "Раздел активности (плавательная дорожка) «Пользователь»: состояния, выполняемые исполнителем «Пользователь»."
						},
						{
							"_type": "UMLActivityPartition",
