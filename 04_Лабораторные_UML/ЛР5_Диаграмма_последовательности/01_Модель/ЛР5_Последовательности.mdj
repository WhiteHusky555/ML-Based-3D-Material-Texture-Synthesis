											"target": {
												"$ref": "fEGkC0rXRNCtM/+dFdQ="
											},
											"messageSort": "synchCall",
											"documentation": "Синхронный вызов операции ПубличнаяСсылка.ОбновитьСнимок() объекта «ссылка: ПубличнаяСсылка» объектом «: КонтроллерПубликации». Назначение операции: Новый снимок по тому же адресу; отозванную ссылку обновить нельзя — исключение.",
											"signature": {
												"$ref": "H0RyX9xLSouT5X9LwD4="
											},
											"name": "ОбновитьСнимок",
