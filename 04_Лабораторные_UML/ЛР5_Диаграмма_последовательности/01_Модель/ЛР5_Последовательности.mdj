											"_type": "UMLMessage",
											"_id": "U5GcRxxaRFeUpfOYHg8=",
											"_parent": {
												"$ref": "V9oQkna4SsOJEuMlc0M="
											},
											"source": {
												"$ref": "6xp31K64QLuuD7PAxLQ="
											},
											"target": {
												"$ref": "RmK88j4iQCKIrheLhfk="
											},
											"messageSort": "reply",
											"documentation": "Ответ на сообщение 1 (Действует()): объект «ссылка: ПубличнаяСсылка» возвращает «да | нет»; пунктирная стрелка — возврат управления вызывающему.",
											"name": "да | нет"
										},
										{
											"_type": "UMLMessage",
											"_id": "8PVe+unjRzKUDFFc/Ck=",
