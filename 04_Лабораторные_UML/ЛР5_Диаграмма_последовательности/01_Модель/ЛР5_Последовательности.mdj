								"$ref": "Gv7q1I9CTj21FfT+Og0="
							},
							"name": "Экспорт материала",
							"documentation": "Алгоритм реализации прецедента «Экспорт материала» в форме автомата: выбор движка, упаковка карт, преобразования для Unreal Engine и премиум-форматов, формирование архива и скачивание. Внутренние переменные (атрибуты вспомогательного объекта потока управления): Движок (строка) — целевой движок: «Blender», «Unity», «Unreal Engine»; Действие (строка) — действие, выбранное в окне: нажатая кнопка, ссылка или закрытие окна.",
							"regions": [
								{
									"_type": "UMLRegion",
									"_id": "FnIXftX+RLKdezjVqZU=",
									"_parent": {
										"$ref": "fYvNpkwPQg+4BsJ4EXI="
									},
									"vertices": [
										{
											"_type": "UMLPseudostate",
