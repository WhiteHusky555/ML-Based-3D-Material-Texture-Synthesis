											},
											"target": {
												"$ref": "2fkvEM64Q9SlrVaw2QA="
											},
											"messageSort": "synchCall",
											"documentation": "Ссылку могли отозвать, пока гость входил. Синхронный вызов операции ПубличнаяСсылка.Действует() объекта «ссылка: ПубличнаяСсылка» объектом «: КонтроллерПубликации». Назначение операции: Не отозвана ли ссылка.",
											"signature": {
												"$ref": "filerfgYTqiAnuoMl+s="
											},
											"name": "Действует"
										},
										{
