											},
											"target": {
												"$ref": "TToIJxkZRfiO+/jOF1c="
											},
											"messageSort": "asynchCall",
											"documentation": "Задача ставится в очередь с приоритетом тарифа (из прецедента «Генерация материала»). Асинхронный вызов (отправитель не ждёт завершения обработки) операции КонвейерГенерации.ПоставитьВОчередь() объекта «: КонвейерГенерации» объектом «: КонтроллерГенерации». Назначение операции: Цепочка noise → generate → upscale → pbr. Стрелка с открытым наконечником — асинхронное сообщение.",
											"signature": {
												"$ref": "4qBj+VtRRfKXvVsXbn8="
											},
											"name": "ПоставитьВОчередь",
											"arguments": "материал, приоритет"
										},
										{
											"_type": "UMLMessage",
											"_id": "E90618/nTOKqy+tEkkk=",
											"_parent": {
												"$ref": "8Rx9dfvURwCXRzqmLag="
											},
											"source": {
												"$ref": "TToIJxkZRfiO+/jOF1c="
											},
											"target": {
