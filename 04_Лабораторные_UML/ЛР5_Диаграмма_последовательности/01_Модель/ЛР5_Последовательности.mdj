											"_parent": {
												"$ref": "7+dwJMxJTRudesyWHLY="
											},
											"name": "",
											"represent": {
												"$ref": "BIJ0jPi8SkSSZv9uRh4="
											},
											"documentation": "Линия жизни: анонимный объект класса «ОкноВхода» (граничный класс). Где работает: веб-клиент (браузер, React); запросы идут в web-bff. После успешного входа открывается главное окно — следующий шаг сценария пользователя (ЛР3, «Сценарий работы пользователя с системой»).",
											"stereotype": "boundary"
										},
										{
											"_type": "UMLLifeline",
											"_id": "Yzrc5bTqSBmFWii50No=",
											"_parent": {
												"$ref": "7+dwJMxJTRudesyWHLY="
											},
											"name": "",
											"represent": {
												"$ref": "avvAasKgS1Sb8nDe+e0="
											},
											"documentation": "Линия жизни: анонимный объект класса «Сеанс» (класс-сущность). Где работает: web-bff (Python, сеансы — в Redis); у персонала ту же роль выполняет staff-ui (сеанс — в памяти пода). Создаётся при входе; хранит токены вместо браузера.",
											"stereotype": "entity"
										},
