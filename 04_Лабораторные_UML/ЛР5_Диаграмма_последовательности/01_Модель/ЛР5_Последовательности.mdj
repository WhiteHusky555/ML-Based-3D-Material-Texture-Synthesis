											},
											"name": "",
											"represent": {
												"$ref": "TnTmvDKtSaaKpO8QNxE="
											},
											"documentation": "Линия жизни: работник «Администратор» (ЛР1). Выбирает раздел панели и действие.",
											"stereotype": "worker"
										},
										{
											"_type": "UMLLifeline",
											"_id": "j3ZKGU2zS2e32kq9ssU=",
