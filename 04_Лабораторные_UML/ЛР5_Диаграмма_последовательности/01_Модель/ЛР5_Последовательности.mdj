												"$ref": "KGbLxxUxTrK+YN+a314="
											},
											"documentation": "Линия жизни: анонимный объект класса «УправлениеСеансами» (управляющий класс). Где работает: web-bff (Python, сеансы — в Redis); у персонала ту же роль выполняет staff-ui (сеанс — в памяти пода).",
											"stereotype": "control"
										}
									],
									"messages": [
										{
											"_type": "UMLMessage",
											"_id": "2PbwH94rSgGlcsiykwg=",
