											"_type": "UMLAttribute",
											"_id": "f7GmA3K+Qoy5huRwVng=",
											"_parent": {
												"$ref": "FAbit02zQHS6YsIKFuY="
											},
											"name": "неудачныхПопыток",
											"visibility": "private",
											"type": "int",
											"documentation": "Число неудачных попыток входа за 15 минут (переменная «Неудачных попыток» ЛР3). Тип int — целое число (счётчик, номер или размер)."
										},
										{
											"_type": "UMLAttribute",
