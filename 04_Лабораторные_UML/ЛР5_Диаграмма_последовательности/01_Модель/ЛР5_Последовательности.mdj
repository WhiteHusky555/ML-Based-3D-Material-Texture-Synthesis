									],
									"messages": [
										{
											"_type": "UMLMessage",
											"_id": "fspxiw2cTpy01O3agfw=",
											"_parent": {
												"$ref": "1PW4OARzTpG4UFT9SGI="
											},
											"source": {
												"$ref": "42oPjainQBWZ9OKcEBQ="
											},
											"target": {
												"$ref": "ETU/KTa2Tzq2ZeRHhgo="
											},
											"messageSort": "asynchCall",
											"documentation": "Платёжная система присылает подписанное уведомление (вебхук POST /api/billing/webhook); повторное уведомление ничего не меняет. Асинхронный вызов (отправитель не ждёт завершения обработки) операции КонтроллерПодписки.ОбработатьУведомление() объекта «: КонтроллерПодписки» объектом «: ПлатёжнаяСистема». Назначение операции: Проверка подписи, активация или отказ; повторное уведомление ничего не меняет. Стрелка с открытым наконечником — асинхронное сообщение.",
											"signature": {
												"$ref": "USP/fphqQ0eYAzr0cq8="
											},
											"name": "ОбработатьУведомление",
											"arguments": "тело, подпись"
										},
										{
											"_type": "UMLMessage",
											"_id": "IWqHHF0wRAW8TrL7WWc=",
											"_parent": {
												"$ref": "1PW4OARzTpG4UFT9SGI="
											},
											"source": {
												"$ref": "ETU/KTa2Tzq2ZeRHhgo="
											},
											"target": {
												"$ref": "42oPjainQBWZ9OKcEBQ="
											},
											"messageSort": "synchCall",
											"documentation": "Синхронный вызов операции ПлатёжнаяСистема.ПроверитьПодпись() объекта «: ПлатёжнаяСистема» объектом «: КонтроллерПодписки». Назначение операции: Проверяет цифровую подпись уведомления.",
											"signature": {
												"$ref": "RH+c1oOSQwO7T//6jgA="
											},
											"name": "ПроверитьПодпись",
											"arguments": "тело, подпись"
