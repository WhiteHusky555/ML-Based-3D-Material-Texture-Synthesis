						"$ref": "5UajWf21RUSoa8Fo64M="
					},
					"name": "Вход по e-mail и паролю",
					"documentation": "Реализует прецедент «Вход по e-mail и паролю» с защитой от перебора паролей: после 5 неудачных попыток за 15 минут вход по адресу блокируется на 15 минут. Результат — вход выполнен или не выполнен.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "guNVSVBVSA6vynX9lII=",
							"_parent": {
								"$ref": "kg07cvDnSvKFDiP5rN4="
							},
							"name": "Пользователь",
							"nodes": [
								{
									"_type": "UMLForkNode",
									"_id": "+AH7RCxhTOe04Ag3Mmg=",
									"_parent": {
										"$ref": "guNVSVBVSA6vynX9lII="
									},
									"name": "",
									"documentation": "Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Отображение формы входа» и «Ввод e-mail и пароля» — окно отображается, пока пользователь работает с ним."
								},
								{
									"_type": "UMLAction",
									"_id": "L2Vf+uHORyK2t3FjuF0=",
									"_parent": {
										"$ref": "guNVSVBVSA6vynX9lII="
									},
									"name": "Ввод e-mail и пароля",
									"documentation": "Пользователь вводит e-mail и пароль в поля отображаемой формы входа (стандартный процесс заполнения полей), поля заполняются в любом порядке."
								},
								{
									"_type": "UMLJoinNode",
									"_id": "QV5wSBJVT/yDzrFnxkU=",
									"_parent": {
										"$ref": "guNVSVBVSA6vynX9lII="
									},
									"name": "",
									"documentation": "Узел синхронизации (Join): ожидает завершения параллельных деятельностей «Отображение формы входа» и «Ввод e-mail и пароля» и только затем передаёт управление дальше."
								}
							],
							"documentation": "Раздел активности (плавательная дорожка) «Пользователь»: состояния, выполняемые исполнителем «Пользователь»."
						},
						{
							"_type": "UMLActivityPartition",
