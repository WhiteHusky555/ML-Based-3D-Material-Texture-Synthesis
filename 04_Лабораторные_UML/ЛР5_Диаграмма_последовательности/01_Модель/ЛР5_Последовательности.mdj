									"_parent": {
										"$ref": "mp3mfm4HTTmf9deGKgM="
									},
									"name": "Подтверждение оплаты",
									"documentation": "Часть прецедента «Управление подпиской» (UC6): платёжная система присылает подписанное уведомление, либо через 15 минут без уведомления контроллер сам запрашивает статус платежа; при успешной оплате подписка активируется и публикуется событие смены тарифа.",
									"participants": [
										{
											"_type": "UMLLifeline",
											"_id": "ETU/KTa2Tzq2ZeRHhgo=",
											"_parent": {
												"$ref": "1PW4OARzTpG4UFT9SGI="
											},
											"name": "",
											"represent": {
												"$ref": "w8luZkdtSe68T1dUR98="
											},
											"documentation": "Линия жизни: анонимный объект класса «КонтроллерПодписки» (управляющий класс). Где работает: сервис пользователей и тарифов (PostgreSQL, схема users).",
											"stereotype": "control"
										},
										{
											"_type": "UMLLifeline",
											"_id": "42oPjainQBWZ9OKcEBQ=",
											"_parent": {
												"$ref": "1PW4OARzTpG4UFT9SGI="
											},
											"name": "",
											"represent": {
												"$ref": "TgpP8DNbSPmXajh6CZ4="
											},
											"documentation": "Линия жизни: анонимный объект класса «ПлатёжнаяСистема» (интерфейс). Где работает: сервис пользователей → внешняя платёжная система (тестовый режим). Шлюз внешней системы «Платёжная система» (актор ЛР1); в ВКР — тестовая реализация.",
											"stereotype": "interface"
										},
										{
											"_type": "UMLLifeline",
											"_id": "dxwlddhbQLq7Lkle4J8=",
