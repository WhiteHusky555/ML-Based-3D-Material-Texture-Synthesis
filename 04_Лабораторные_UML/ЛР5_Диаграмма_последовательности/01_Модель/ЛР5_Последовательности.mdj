											"target": {
												"$ref": "t2cbS3KBRp6Vut9Bg30="
											},
											"messageSort": "synchCall",
											"documentation": "Номера запросов и квота не тратятся. Синхронный вызов операции ЦепочкаЗапросов.ЗадатьПредысторию() объекта «копия: ЦепочкаЗапросов» объектом «: КонтроллерПубликации». Назначение операции: Шаги предыстории копии задаются один раз при её создании; повторный вызов отклоняется — дополнить копию чужими шагами позже нельзя.",
											"signature": {
												"$ref": "FVMeTLT2RImv3db7OM0="
											},
											"name": "ЗадатьПредысторию",
											"arguments": "шаги"
										}
