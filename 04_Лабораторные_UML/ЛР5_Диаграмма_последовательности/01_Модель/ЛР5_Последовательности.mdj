									"messages": [
										{
											"_type": "UMLMessage",
											"_id": "S1QApdH2Tnapm73Fbs4=",
											"_parent": {
												"$ref": "3c7ADuETSoWJb3dcI4c="
											},
											"source": {
												"$ref": "M5g3LkSAR9KnHjrrk0k="
											},
											"target": {
												"$ref": "q9CHiJp3RQacPnTzMIw="
											},
											"messageSort": "synchCall",
											"documentation": "Внутренний запрос /internal/auth/login от web-bff к сервису пользователей. Синхронный вызов операции КонтроллерВхода.Войти() объекта «: КонтроллерВхода» объектом «: УправлениеСеансами». Назначение операции: Вход с защитой от перебора; после успешной проверки — Пользователь.ОбновитьХэш(); токены возвращаются BFF и в браузер не попадают.",
											"signature": {
												"$ref": "p6eI2E07SmODYcIVjIo="
											},
											"name": "Войти",
											"arguments": "email, пароль"
