<XPD:OBJ name="Behaviors[13]" type="UMLActivityGraph" guid="HHPAtNvRRHqMZwdYb94iPAAA">
<XPD:ATTR name="Name" type="string">Обработка задачи генерации</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Асинхронная обработка задачи генерации по очередям RabbitMQ: карта шума, генерация текстуры диффузионной моделью, повышение разрешения, расчёт PBR-карт. Объединяет прецеденты «Генерация текстуры», «Повышение разрешения текстуры», «Расчёт PBR-карт» и «Отмена генерации». Каждый воркер публикует события хода выполнения, которые API-сервис пересылает клиенту по WebSocket.</XPD:ATTR>
<XPD:REF name="Context">EA7qwiDjQ2qpduxtchBK/QAA</XPD:REF>
<XPD:OBJ name="Top" type="UMLCompositeState" guid="Pqp1wscuRHeB8mcOEDMVUwAA">
<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">HHPAtNvRRHqMZwdYb94iPAAA</XPD:REF>
<XPD:ATTR name="#Subvertices" type="integer">16</XPD:ATTR>
<XPD:OBJ name="Subvertices[0]" type="UMLPseudostate" guid="vLor8GnbTeeYEAq8Z2uVNgAA">
<XPD:ATTR name="Documentation" type="string">Начальное состояние: начало выполнения деятельности «Обработка задачи генерации».</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkInitial</XPD:ATTR>
<XPD:REF name="ContainerState">Pqp1wscuRHeB8mcOEDMVUwAA</XPD:REF>
