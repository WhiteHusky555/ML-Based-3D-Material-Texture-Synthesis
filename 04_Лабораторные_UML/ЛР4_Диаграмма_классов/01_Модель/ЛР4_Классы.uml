<XPD:OBJ name="Effects[0]" type="UMLUninterpretedAction" guid="ORQmqYuARqaPUEVI8gvvSgAA">
<XPD:ATTR name="Name" type="string">Действие := выбранное</XPD:ATTR>
<XPD:REF name="Transition">R7EOurXbQgmCtP8EXZ0PZgAA</XPD:REF>
