<XPD:ATTR name="#Outgoings" type="integer">1</XPD:ATTR>
<XPD:REF name="Outgoings[0]">2vg872KMRsOIW6tFyEaRjAAA</XPD:REF>
<XPD:ATTR name="#Incomings" type="integer">1</XPD:ATTR>
<XPD:REF name="Incomings[0]">o5+hAMHbSAiIqvzqpmxwyQAA</XPD:REF>
</XPD:OBJ>
