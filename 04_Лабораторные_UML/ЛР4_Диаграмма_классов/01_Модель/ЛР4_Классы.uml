<XPD:ATTR name="#Outgoings" type="integer">1</XPD:ATTR>
<XPD:REF name="Outgoings[0]">YpV6XN+HSRueTPY8O0Xi+wAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Subvertices[1]" type="UMLPseudostate" guid="+sXkTCYvR1Oh8g0UFMVGfAAA">
<XPD:ATTR name="Documentation" type="string">Псевдосостояние разветвления: запускает параллельные состояния «Отображение окна входа» и «Действия пользователя» — окно отображается, пока пользователь работает с ним.</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkSynchronization</XPD:ATTR>
<XPD:REF name="ContainerState">e40+PII4Q3OKwqzPh0jsXwAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">1</XPD:ATTR>
