<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">sVkooqaISBiKjCEMzFACbwAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">16NaNhbFRP2mJCVb/VlCjQAA</XPD:REF>
</XPD:OBJ>
