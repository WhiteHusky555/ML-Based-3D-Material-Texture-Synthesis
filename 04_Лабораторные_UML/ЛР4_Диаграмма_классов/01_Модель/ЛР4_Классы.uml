<XPD:ATTR name="TypeExpression" type="string">Роль</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Роль для проверки прав на сервере при каждом запросе.</XPD:ATTR>
<XPD:REF name="Owner">ZkrmQoJ/RHSQVhCaaTCMPQAA</XPD:REF>
</XPD:OBJ>
