<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">IHP5abmWSw6b7bxEvykniAAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">2</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">rXaDQZY4TcOpYRfz22aBYAAA</XPD:REF>
<XPD:REF name="SubmachineStates[1]">0JstaeX7SBepzaRSC0fi7QAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Behaviors[30]" type="UMLActivityGraph" guid="NhmDFjXLR4W2dv22FziAhwAA">
<XPD:ATTR name="Name" type="string">Администрирование системы</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Алгоритм реализации варианта использования «Администрирование системы»: выбор раздела панели (пользователи, пресеты, модели, мониторинг), выполнение операции, запись изменений в журнал аудита.</XPD:ATTR>
