<XPD:REF name="DoActivityState">izynO/qxRK6NSZ0LOibsTgAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="DoActivities[1]" type="UMLUninterpretedAction" guid="xWRl3BygTSO2lEhc0P+OAAAA">
