<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">Sm65+vVMQd2EhZ1EAt1nswAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
