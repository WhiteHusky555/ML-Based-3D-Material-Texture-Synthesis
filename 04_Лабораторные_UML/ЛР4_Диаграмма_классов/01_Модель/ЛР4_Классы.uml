<XPD:REF name="Views[0]">sGgmaXhdT2eg+6uMTcRO7QAA</XPD:REF>
<XPD:ATTR name="#OwnerPartitions" type="integer">1</XPD:ATTR>
<XPD:REF name="OwnerPartitions[0]">gDuaZDeXRe+xUa1a7zl1vQAA</XPD:REF>
<XPD:ATTR name="#Outgoings" type="integer">1</XPD:ATTR>
<XPD:REF name="Outgoings[0]">3tdyUNhQR2iUJ6Ep5QUyfgAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Subvertices[1]" type="UMLActionState" guid="EYEBbJQFS0mbMYC3wwWPHwAA">
<XPD:ATTR name="Name" type="string">Получение прав тарифа пользователя</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Система (API-сервис) берёт тариф из заголовка X-User-Plan и читает права тарифа у сервиса пользователей (GET /internal/plans/{plan}): лимит генераций в сутки, разрешения, шаги, варианты, доступ к референсу.</XPD:ATTR>
<XPD:REF name="ContainerState">tuX3FiyKQzGuckyoK+5GYQAA</XPD:REF>
