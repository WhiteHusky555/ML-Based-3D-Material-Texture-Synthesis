<XPD:ATTR name="TypeExpression" type="string">str</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Адрес электронной почты — логин; уникален, хранится в нижнем регистре. Тип str — строка (текст).</XPD:ATTR>
<XPD:REF name="Owner">ZkrmQoJ/RHSQVhCaaTCMPQAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Attributes[2]" type="UMLAttribute" guid="anuyAuu7QuGApsqi0XlTQAAA">
