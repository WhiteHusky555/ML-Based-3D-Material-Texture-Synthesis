<XPD:REF name="Views[2]">QMMXHdRWShmvzTw6FA8FpAAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="JmSCyvG0RUCMWlFiQ/EoeAAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">IuzNs5npRMCTCxHpfn3qZAAA</XPD:REF>
</XPD:OBJ>
