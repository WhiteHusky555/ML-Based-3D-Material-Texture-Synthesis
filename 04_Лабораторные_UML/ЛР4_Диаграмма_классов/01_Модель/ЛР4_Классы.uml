<XPD:ATTR name="Documentation" type="string">Начальное состояние: начало выполнения деятельности «Управление подпиской».</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkInitial</XPD:ATTR>
