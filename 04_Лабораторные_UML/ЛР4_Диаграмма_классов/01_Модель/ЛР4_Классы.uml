<XPD:REF name="Views[1]">RvB/0h+rS8C/nUiS3CYRWQAA</XPD:REF>
<XPD:REF name="Views[2]">2npuDAoNQ6KjjJZz62NWFgAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="QrZvHGJzSY6Hi8+cV4vB8wAA">
