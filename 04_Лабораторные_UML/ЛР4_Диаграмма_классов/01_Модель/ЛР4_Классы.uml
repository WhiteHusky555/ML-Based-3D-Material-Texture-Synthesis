<XPD:ATTR name="TypeExpression" type="string">str</XPD:ATTR>
<XPD:REF name="BehavioralFeature">ksOPIQCIRpqSl1MfgusTTAAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Parameters[1]" type="UMLParameter" guid="ekFBWGgmS+yE9562YdllHgAA">
