<XPD:REF name="Views[2]">+XR6pWqNT3WiB0QD2dPBHQAA</XPD:REF>
<XPD:ATTR name="#Triggers" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="6UBcYk/vTN6PZsv2eWXb1QAA">
