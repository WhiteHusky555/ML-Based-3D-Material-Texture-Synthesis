<XPD:OBJ name="Behaviors[17]" type="UMLStateMachine" guid="8oaM3kdxSBGMpKv1nRQpPQAA">
<XPD:ATTR name="Name" type="string">Жизненный цикл подписки</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Автомат объекта «Подписка» в прецедентах «Управление подпиской» и «Оформление премиум-подписки»: бесплатный тариф, активная подписка, отключённое продление, продление по дате окончания, истечение. Переходы по датам — события времени, их обрабатывает периодическая задача (CronJob). Внутренние переменные (атрибуты вспомогательного объекта потока управления): Тариф (строка) — текущий тариф пользователя; Срок хранения (дни) — срок хранения материалов.</XPD:ATTR>
<XPD:REF name="Context">KmNS/K/tTweho00SXqXT8QAA</XPD:REF>
<XPD:OBJ name="Top" type="UMLCompositeState" guid="eqBYx3h9S6Ct0n/hC8H67AAA">
<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">8oaM3kdxSBGMpKv1nRQpPQAA</XPD:REF>
<XPD:ATTR name="#Subvertices" type="integer">7</XPD:ATTR>
<XPD:OBJ name="Subvertices[0]" type="UMLPseudostate" guid="kanjVKy/STS3GvGMX9dWRgAA">
<XPD:ATTR name="Documentation" type="string">Начальное псевдосостояние автомата «Жизненный цикл подписки».</XPD:ATTR>
<XPD:ATTR name="PseudostateKind" type="UMLPseudostateKind">pkInitial</XPD:ATTR>
<XPD:REF name="ContainerState">eqBYx3h9S6Ct0n/hC8H67AAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">1</XPD:ATTR>
<XPD:REF name="Views[0]">SWHjkpTnSJmg0Y20NReKBAAA</XPD:REF>
<XPD:ATTR name="#Outgoings" type="integer">1</XPD:ATTR>
<XPD:REF name="Outgoings[0]">Fy+w6j9UTnaAOPUyD14zWAAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Subvertices[1]" type="UMLCompositeState" guid="AFT7s9lFQE6XWc2wkaV50gAA">
