<XPD:ATTR name="TypeExpression" type="string">Роль</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Роль для проверки прав на сервере при каждом запросе.</XPD:ATTR>
<XPD:REF name="Owner">uTtDeQkxSOmZYRSbbIYN0AAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Attributes[5]" type="UMLAttribute" guid="gtCOjAeWQOeK13jXx06yoAAA">
<XPD:ATTR name="Name" type="string">статус</XPD:ATTR>
<XPD:ATTR name="Visibility" type="UMLVisibilityKind">vkPrivate</XPD:ATTR>
<XPD:ATTR name="TypeExpression" type="string">СтатусУчётнойЗаписи</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Состояние учётной записи (автомат ЛР3 «Жизненный цикл учётной записи»). Тип СтатусУчётнойЗаписи — перечисление «СтатусУчётнойЗаписи» (допустимы только его значения).</XPD:ATTR>
