<XPD:OBJ name="Triggers[0]" type="UMLSignalEvent" guid="bp73CNgkRoqad8+/cpktEQAA">
<XPD:ATTR name="Name" type="string">выбрано действие</XPD:ATTR>
<XPD:REF name="Transition">LbQxCHwGQa+wwRPjQbsZ3AAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#Effects" type="integer">1</XPD:ATTR>
<XPD:OBJ name="Effects[0]" type="UMLUninterpretedAction" guid="0kE2Y54XRtOJ6cSRQN7UywAA">
<XPD:ATTR name="Name" type="string">Действие := выбранное</XPD:ATTR>
