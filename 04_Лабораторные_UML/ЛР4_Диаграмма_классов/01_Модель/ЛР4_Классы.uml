<XPD:ATTR name="Name" type="string">Статус := «новая»</XPD:ATTR>
<XPD:REF name="EntryState">Kv8bIFz8TZqvqu7Du4MXigAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#DoActivities" type="integer">1</XPD:ATTR>
<XPD:OBJ name="DoActivities[0]" type="UMLUninterpretedAction" guid="wzZxzvYeRfS7nxJX7jlgdQAA">
<XPD:ATTR name="Name" type="string">Показ окна и реакция на действия</XPD:ATTR>
<XPD:REF name="DoActivityState">Kv8bIFz8TZqvqu7Du4MXigAA</XPD:REF>
