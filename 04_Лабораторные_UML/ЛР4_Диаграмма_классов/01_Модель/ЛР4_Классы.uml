</XPD:OBJ>
<XPD:OBJ name="Subvertices[3]" type="UMLCompositeState" guid="A1e+PNdpQCi+jGoW+eEgpwAA">
<XPD:ATTR name="Name" type="string">Отображение окна генератора</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Простое состояние: окно отображается системой параллельно с действиями пользователя; внутренняя деятельность потенциально бесконечна, выход только по событию. Окно с пресетами, превью шума плиткой 3×3, полем описания и кнопкой «Сгенерировать»; превью обновляется при изменении формы. Деятельности состояния семантически просты, отдельная диаграмма не приводится.</XPD:ATTR>
<XPD:REF name="ContainerState">cGbEO9VmSImqvm2EETD1OgAA</XPD:REF>
<XPD:ATTR name="#Views" type="integer">2</XPD:ATTR>
<XPD:REF name="Views[0]">OcGVTta4SjOH1yz4jBOWAAAA</XPD:REF>
<XPD:REF name="Views[1]">19dLTsZ/RmmhrMRuCU1UXAAA</XPD:REF>
<XPD:ATTR name="#Outgoings" type="integer">1</XPD:ATTR>
<XPD:REF name="Outgoings[0]">TsO37X4BTh+mDX44CCh3lgAA</XPD:REF>
<XPD:ATTR name="#Incomings" type="integer">1</XPD:ATTR>
<XPD:REF name="Incomings[0]">zzwuNi/fQ8Gn+vTmkY38AAAA</XPD:REF>
<XPD:ATTR name="#EntryActions" type="integer">1</XPD:ATTR>
<XPD:OBJ name="EntryActions[0]" type="UMLUninterpretedAction" guid="pRDmhqUUSyuGYUN4HAxU+wAA">
<XPD:ATTR name="Name" type="string">Статус := «новая»</XPD:ATTR>
<XPD:REF name="EntryState">A1e+PNdpQCi+jGoW+eEgpwAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#DoActivities" type="integer">1</XPD:ATTR>
<XPD:OBJ name="DoActivities[0]" type="UMLUninterpretedAction" guid="r1EeaLT4Symp7unjqDYLpgAA">
<XPD:ATTR name="Name" type="string">Показ окна и реакция на действия</XPD:ATTR>
<XPD:REF name="DoActivityState">A1e+PNdpQCi+jGoW+eEgpwAA</XPD:REF>
