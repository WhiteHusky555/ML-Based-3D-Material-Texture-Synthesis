<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">UWiq8HNTT4+n0FkaKHS1oAAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">PbpmS7ZlSVSkNSA6N/bU+QAA</XPD:REF>
</XPD:OBJ>
