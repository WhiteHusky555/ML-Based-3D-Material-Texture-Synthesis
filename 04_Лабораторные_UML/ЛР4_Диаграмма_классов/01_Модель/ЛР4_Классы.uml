<XPD:REF name="StateMachine">1xbp3FthRr6ERfaKAad0CAAA</XPD:REF>
<XPD:ATTR name="#Subvertices" type="integer">9</XPD:ATTR>
<XPD:OBJ name="Subvertices[0]" type="UMLPseudostate" guid="6Rly28B3ROiD1mwbT9MC+wAA">
