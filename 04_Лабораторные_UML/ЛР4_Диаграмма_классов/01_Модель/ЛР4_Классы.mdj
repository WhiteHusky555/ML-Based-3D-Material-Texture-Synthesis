													"_type": "UMLOpaqueBehavior",
													"_id": "KJ8JRidMTr2UVIeOyJM=",
													"_parent": {
														"$ref": "+aG4PzE4QzaX+JbvNvY="
													},
													"name": "Сравнение тарифов"
