				{
					"_type": "UMLActivity",
					"_id": "7x5PFcWWREOX6W5cexU=",
					"_parent": {
						"$ref": "qlNYZYvaQtWusxCuHmE="
					},
					"name": "Обработка задачи генерации",
					"documentation": "Асинхронная обработка задачи генерации по очередям RabbitMQ: карта шума, генерация текстуры диффузионной моделью, повышение разрешения, расчёт PBR-карт. Объединяет прецеденты «Генерация текстуры», «Повышение разрешения текстуры», «Расчёт PBR-карт» и «Отмена генерации». Каждый воркер публикует события хода выполнения, которые API-сервис пересылает клиенту по WebSocket.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "zR3O7owzQWa46h4AuBI=",
							"_parent": {
								"$ref": "7x5PFcWWREOX6W5cexU="
							},
							"name": "API-сервис",
							"nodes": [
								{
									"_type": "UMLInitialNode",
									"_id": "gAZHvpoESf6Ca6cGWEI=",
									"_parent": {
										"$ref": "zR3O7owzQWa46h4AuBI="
									},
									"name": "",
									"documentation": "Начальное состояние: начало выполнения деятельности «Обработка задачи генерации»."
								},
								{
									"_type": "UMLAction",
									"_id": "3K37kvHEQaqKj7b/Ss0=",
									"_parent": {
										"$ref": "zR3O7owzQWa46h4AuBI="
									},
									"name": "Постановка цепочки задач в очередь",
									"documentation": "API-сервис ставит цепочку Celery noise → generate → upscale → pbr с приоритетом по тарифу (премиум — высокий) в очереди noise, gpu и cpu."
								},
								{
									"_type": "UMLAction",
									"_id": "IwDcs87NQ06t9+rIjc8=",
									"_parent": {
										"$ref": "zR3O7owzQWa46h4AuBI="
									},
									"name": "Освобождение задачи без списания квоты",
									"documentation": "API-сервис помечает задачу «отменена», возвращает резерв квоты и удаляет промежуточные файлы."
								},
								{
									"_type": "UMLAction",
									"_id": "4/M9GjqWT823jerAJ94=",
									"_parent": {
										"$ref": "zR3O7owzQWa46h4AuBI="
									},
									"name": "Фиксация ошибки без списания квоты",
									"documentation": "API-сервис помечает задачу «ошибка», возвращает резерв квоты, записывает подробности в журнал и Sentry, а клиенту отправляет безопасное сообщение о сбое."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "aV93Xz0mRBCL3xiKcX8=",
									"_parent": {
										"$ref": "zR3O7owzQWa46h4AuBI="
									},
									"name": "",
									"documentation": "Конечное состояние: задача отменена."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "c63Bk6gtQ1mDc4j7F/g=",
									"_parent": {
