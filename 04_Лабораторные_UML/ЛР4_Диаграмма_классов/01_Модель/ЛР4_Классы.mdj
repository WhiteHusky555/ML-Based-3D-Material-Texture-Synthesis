				{
					"_type": "UMLActivity",
					"_id": "fJ49eOzFQZ++UaVA1gc=",
					"_parent": {
						"$ref": "fMcECYfITGyp5t2RbyU="
					},
					"name": "Создание варианта материала",
					"documentation": "Реализует прецедент «Создание варианта материала». Система копирует параметры выбранного материала (шум, пресет, описание, модификаторы, разрешение, seed) в окно генератора, где пользователь меняет их и запускает новую генерацию; исходный материал не изменяется. Деятельность семантически проста, её алгоритм полностью раскрыт в описании, поэтому отдельная диаграмма реализации не приводится."
				},
				{
					"_type": "UMLActivity",
					"_id": "tFVsKbi7SYGOPp/QWQI=",
					"_parent": {
						"$ref": "fMcECYfITGyp5t2RbyU="
					},
					"name": "Работа с историей запросов",
					"documentation": "Алгоритм реализации варианта использования «Работа с историей запросов»: показ цепочек и их запросов, открытие материала, создание варианта, удаление цепочки или материала, публикация цепочки по ссылке и отзыв ссылки с возвратом к списку.",
					"groups": [
						{
							"_type": "UMLActivityPartition",
							"_id": "08XvfD7fQFqThz2RsT4=",
							"_parent": {
								"$ref": "tFVsKbi7SYGOPp/QWQI="
							},
							"name": "Пользователь",
							"nodes": [
								{
									"_type": "UMLForkNode",
									"_id": "OvX9Z3cPT9WNEx/oprY=",
									"_parent": {
										"$ref": "08XvfD7fQFqThz2RsT4="
									},
									"name": "",
									"documentation": "Узел разветвления (Fork): запускает параллельно выполняемые деятельности «Выбор действия с цепочкой или запросом» и «Показ списка цепочек и запросов» — окно отображается, пока пользователь работает с ним."
								},
								{
									"_type": "UMLAction",
									"_id": "K0FDoOz1RoSY40HuwyE=",
									"_parent": {
										"$ref": "08XvfD7fQFqThz2RsT4="
									},
									"name": "Выбор действия с цепочкой или запросом",
									"documentation": "Пользователь просматривает цепочки и выбирает запрос, нажимает «Изменить параметры», «Удалить» (с подтверждением в диалоге; при отказе выбор продолжается) или «Поделиться», либо закрывает историю."
								},
								{
									"_type": "UMLJoinNode",
									"_id": "Ojw7Lf21SDeHROwCGh0=",
									"_parent": {
										"$ref": "08XvfD7fQFqThz2RsT4="
									},
									"name": "",
									"documentation": "Узел синхронизации (Join): ожидает завершения параллельных деятельностей «Показ списка цепочек и запросов» и «Выбор действия с цепочкой или запросом» и только затем передаёт управление дальше."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "PcfKHpzJS32s7dpzdy0=",
									"_parent": {
										"$ref": "08XvfD7fQFqThz2RsT4="
									},
									"name": "",
									"documentation": "Конечное состояние: история закрыта."
								}
							],
							"documentation": "Раздел активности (плавательная дорожка) «Пользователь»: состояния, выполняемые исполнителем «Пользователь»."
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "p1OgPZXxSyWJcaZ2sHo=",
							"_parent": {
								"$ref": "tFVsKbi7SYGOPp/QWQI="
							},
							"name": "Система",
							"nodes": [
								{
									"_type": "UMLInitialNode",
									"_id": "tG3nAjuOTcGFPZNZwXk=",
									"_parent": {
										"$ref": "p1OgPZXxSyWJcaZ2sHo="
									},
									"name": "",
									"documentation": "Начальное состояние: начало выполнения деятельности «Работа с историей запросов»."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "SHgTPc/SSaiGLgbFeKU=",
									"_parent": {
										"$ref": "p1OgPZXxSyWJcaZ2sHo="
									},
									"name": "",
									"documentation": "Узел слияния: объединяет запуск деятельности и возвраты к списку после удаления и работы со ссылкой."
								},
								{
									"_type": "UMLAction",
									"_id": "JFsYLM+gQnu30uTdtmw=",
									"_parent": {
										"$ref": "p1OgPZXxSyWJcaZ2sHo="
									},
									"name": "Получение списка цепочек",
									"documentation": "Система читает цепочки пользователя постранично (по 24): название, дату, миниатюру последнего результата, признак публикации, а в открытой цепочке — её запросы с номерами, кодами и сроками хранения материалов."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "8ixbzakNTv6YHwCtM14=",
									"_parent": {
										"$ref": "p1OgPZXxSyWJcaZ2sHo="
									},
									"name": "",
									"documentation": "Узел решения: пуста ли история."
								},
								{
									"_type": "UMLAction",
									"_id": "2X7ChGUFRgOTXiBcv4k=",
									"_parent": {
										"$ref": "p1OgPZXxSyWJcaZ2sHo="
									},
									"name": "Предложение создать первый материал",
									"documentation": "Система показывает пустое состояние с кнопкой перехода к генератору."
								},
								{
									"_type": "UMLAction",
									"_id": "/RdQXhZJSzeUxwjXdF8=",
									"_parent": {
										"$ref": "p1OgPZXxSyWJcaZ2sHo="
									},
									"name": "Показ списка цепочек и запросов",
									"documentation": "Система показывает список цепочек; в открытой цепочке — запросы с номерами, кодами, миниатюрами и сроками хранения, кнопки «Удалить», «Изменить параметры», «Поделиться»; реагирует на действия пользователя (листание, открытие цепочки, диалог подтверждения удаления). Деятельность выполняется параллельно с выбором и завершается событием «выбрано действие»."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "u8iIYwxhSwyf0jb3wkU=",
									"_parent": {
										"$ref": "p1OgPZXxSyWJcaZ2sHo="
									},
									"name": "",
									"documentation": "Конечное состояние: история пуста."
								},
