				{
					"_type": "UMLPackage",
					"_id": "AbehgIm2RvCHk/tA3vw=",
					"_parent": {
						"$ref": "fMcECYfITGyp5t2RbyU="
					},
					"name": "Автоматы",
					"documentation": "Пакет ЛР3: автоматы — сценарии работы акторов с системой, алгоритмы реализации вариантов использования в форме автомата и автоматы декомпозиции (обработка задачи генерации, жизненные циклы подписки и учётной записи, работа со ссылкой на цепочку).",
					"ownedElements": [
						{
							"_type": "UMLStateMachine",
							"_id": "c+/XMXIBTPa2O2OzqMU=",
							"_parent": {
								"$ref": "AbehgIm2RvCHk/tA3vw="
							},
							"name": "Сценарий работы пользователя с системой",
							"documentation": "Сценарий использования системы пользователем и премиум-пользователем (наследует сценарий по генерализации): вход, выбор варианта использования в главном окне, чередование вариантов использования до выхода. Различия премиум-тарифа реализованы сторожевыми условиями внутри автоматов прецедентов. Внутренние переменные (атрибуты вспомогательного объекта потока управления): Выход (Boolean) — признак завершения работы сотрудником или пользователем; False — работа продолжается, True — выбран выход.",
							"regions": [
								{
									"_type": "UMLRegion",
									"_id": "54eE89ZEQfKAsbDVWFc=",
