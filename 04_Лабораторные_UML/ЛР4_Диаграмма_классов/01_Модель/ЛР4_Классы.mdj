												}
											],
											"effects": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "ZFVLgYdDQtOpZnB9pxM=",
													"_parent": {
														"$ref": "BCx0OM95TkyNknPsKjU="
													},
													"name": "Действие := выбранное"
												}
											],
											"documentation": "Над стрелкой перехода из «Отображение панели» в псевдосостояние синхронизации указаны: событие «выбрано действие», действие на переходе «Действие := выбранное»; внутренняя деятельность состояния «Отображение панели» — отображение окна параллельно с действиями пользователя — потенциально бесконечна, поэтому выход из него возможен только по событию; псевдосостояние синхронизации передаёт управление дальше, когда завершатся и действия пользователя; действие выполняется при переходе и изменяет внутреннюю переменную или состояние объекта."
										},
										{
											"_type": "UMLTransition",
											"_id": "OzkT2KNFTlW6I76ayVw=",
											"_parent": {
												"$ref": "DvHWhHFfT3q6AEoynAQ="
											},
											"source": {
