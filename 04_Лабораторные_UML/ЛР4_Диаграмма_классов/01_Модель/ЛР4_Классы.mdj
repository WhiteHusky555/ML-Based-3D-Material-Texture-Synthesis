											"_parent": {
												"$ref": "DvHWhHFfT3q6AEoynAQ="
											},
											"name": "",
											"kind": "initial",
											"documentation": "Начальное псевдосостояние автомата «Администрирование системы»."
										},
										{
											"_type": "UMLPseudostate",
