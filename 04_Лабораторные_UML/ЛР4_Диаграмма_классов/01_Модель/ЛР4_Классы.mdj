						{
							"_type": "UMLStateMachine",
							"_id": "0UGWQ7EbRmW/83pqgGU=",
							"_parent": {
								"$ref": "sPxXxgLnQuujCTGdOPo="
							},
							"name": "Генерация материала",
							"documentation": "Алгоритм реализации прецедента «Генерация материала» в форме автомата: окно генератора, проверка прав тарифа, выдача из кэша или обработка задачи (ссылочное состояние на автомат «Обработка задачи генерации»), сохранение материала. Внутренние переменные (атрибуты вспомогательного объекта потока управления): Статус (строка) — статус задачи генерации: «новая», «в очереди», «шум», «генерация», «апскейл», «pbr», «готово», «ошибка», «отменена»; Действие (строка) — действие, выбранное в окне: нажатая кнопка, ссылка или закрытие окна.",
							"regions": [
								{
									"_type": "UMLRegion",
									"_id": "wXNi1XP9SN6b9Qc9EYY=",
									"_parent": {
										"$ref": "0UGWQ7EbRmW/83pqgGU="
									},
									"vertices": [
