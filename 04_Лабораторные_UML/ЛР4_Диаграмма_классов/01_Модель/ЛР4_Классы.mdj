													"_parent": {
														"$ref": "7c/b8ueeRDmeJV+vu0Y="
													},
													"name": "Выбор расширенных форматов"
												}
											],
											"exitActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "dH3pZwl7QwebFF/8NJE=",
