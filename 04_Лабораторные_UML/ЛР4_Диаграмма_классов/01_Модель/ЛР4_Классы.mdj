						{
							"_type": "UMLStateMachine",
							"_id": "vA2Ay0D2RG+/OUlh00o=",
							"_parent": {
								"$ref": "2fi/KCqZSNCnQFOJRrc="
							},
							"name": "Просмотр материала в 3D",
							"documentation": "Алгоритм реализации прецедента «Просмотр материала в 3D» в форме автомата: загрузка карт, осмотр, смена режима (карта, форма объекта, своя модель на премиум-тарифе) с возвратом к осмотру. Внутренние переменные (атрибуты вспомогательного объекта потока управления): Объект (строка) — объект просмотра: «сфера», «плоскость», «куб», «модель» (своя модель пользователя); Действие (строка) — действие, выбранное в окне: нажатая кнопка, ссылка или закрытие окна.",
							"regions": [
								{
									"_type": "UMLRegion",
									"_id": "X6LTh6XMTK2h5ze/dvM=",
									"_parent": {
										"$ref": "vA2Ay0D2RG+/OUlh00o="
									},
									"vertices": [
