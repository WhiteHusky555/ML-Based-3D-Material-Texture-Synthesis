													},
													"name": "выбрано действие",
													"kind": "signal"
												}
											],
											"effects": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "y8bV2xzUT3OQYBGckXc=",
													"_parent": {
														"$ref": "iVBphawnSsOnRcycTf0="
													},
													"name": "Действие := выбранное"
												}
											],
											"documentation": "Над стрелкой перехода из «Отображение окна публикации» в псевдосостояние синхронизации указаны: событие «выбрано действие», действие на переходе «Действие := выбранное»; внутренняя деятельность состояния «Отображение окна публикации» — отображение окна параллельно с действиями пользователя — потенциально бесконечна, поэтому выход из него возможен только по событию; псевдосостояние синхронизации передаёт управление дальше, когда завершатся и действия пользователя; действие выполняется при переходе и изменяет внутреннюю переменную или состояние объекта."
										},
										{
											"_type": "UMLTransition",
											"_id": "FrYvvCqhRWau3lCJ10o=",
											"_parent": {
												"$ref": "Er23Wxs8RqCLi+fRKNA="
											},
											"source": {
												"$ref": "Ele74FIeRDalL/L8WWY="
											},
											"target": {
												"$ref": "BQL/ZYa6RNOa4qA/Qp4="
											},
											"documentation": "Стрелка перехода из «Действия пользователя» в псевдосостояние синхронизации не содержит надписей: переход осуществляется по завершению внутренних деятельностей состояния «Действия пользователя» (действие exit); псевдосостояние синхронизации ожидает завершения всех параллельных состояний."
										},
										{
											"_type": "UMLTransition",
											"_id": "PH35Li1WSq+euZuCO5U=",
