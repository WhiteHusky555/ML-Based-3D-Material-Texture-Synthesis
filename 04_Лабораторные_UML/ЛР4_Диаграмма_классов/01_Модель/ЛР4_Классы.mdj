													"_parent": {
														"$ref": "qjnZesskTsqLBjhuCRo="
													},
													"name": "Загрузка карт по временным ссылкам"
												}
											],
											"documentation": "Простое состояние: внутренняя деятельность — деятельность ЛР2 «Загрузка карт материала»."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "Y7q2GeJbQROJNsHWIss=",
											"_parent": {
												"$ref": "ubMg90tcQ3ehmezlnEE="
											},
											"name": "",
											"kind": "junction",
											"documentation": "Псевдосостояние соединения: объединяет первый показ и возвраты к осмотру материала."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "dBubVw4RQe29oF1C3QI=",
											"_parent": {
												"$ref": "ubMg90tcQ3ehmezlnEE="
											},
											"name": "",
											"kind": "fork",
											"documentation": "Псевдосостояние разветвления: запускает параллельные состояния «Отображение окна просмотра» и «Действия пользователя» — окно отображается, пока пользователь работает с ним."
										},
										{
											"_type": "UMLState",
											"_id": "Ins8bsqQQRegJIarWg4=",
											"_parent": {
												"$ref": "ubMg90tcQ3ehmezlnEE="
											},
											"name": "Отображение окна просмотра",
											"doActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "7AsnD7DST5KTTCgVWGQ=",
													"_parent": {
														"$ref": "Ins8bsqQQRegJIarWg4="
													},
													"name": "Показ материала и реакция на мышь"
												}
											],
											"documentation": "Простое состояние: окно отображается системой параллельно с действиями пользователя; внутренняя деятельность потенциально бесконечна, выход только по событию. Материал показывается на текущем объекте с освещением, объект поворачивается и масштабируется вслед за мышью. Деятельности состояния семантически просты, отдельная диаграмма не приводится."
										},
										{
											"_type": "UMLState",
											"_id": "PqKzjADgT3663/3YiBY=",
											"_parent": {
												"$ref": "ubMg90tcQ3ehmezlnEE="
											},
											"name": "Действия пользователя",
											"doActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "7dK3bgjzTyivgYlFXMs=",
													"_parent": {
														"$ref": "PqKzjADgT3663/3YiBY="
													},
													"name": "Вращение и масштабирование объекта"
												}
											],
											"exitActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "3LFoFgZsR+6GBpqtSfg=",
													"_parent": {
														"$ref": "PqKzjADgT3663/3YiBY="
													},
													"name": "Выбор режима или закрытие"
												}
											],
											"documentation": "Простое состояние: действия в окне, выполняемые параллельно с его отображением; внутренние деятельности do выполняются в любом порядке, состояние завершается действием exit. Пользователь осматривает материал и выбирает режим (карта, форма объекта, своя модель) или закрывает просмотр. Деятельности состояния семантически просты, отдельная диаграмма не приводится."
										},
										{
											"_type": "UMLPseudostate",
