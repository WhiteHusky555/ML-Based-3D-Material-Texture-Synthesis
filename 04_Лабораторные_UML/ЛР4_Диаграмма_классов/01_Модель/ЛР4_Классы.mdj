						{
							"_type": "UMLStateMachine",
							"_id": "MpzX1fpyQlGBNneeZFs=",
							"_parent": {
								"$ref": "2fi/KCqZSNCnQFOJRrc="
							},
							"name": "Регистрация и вход в систему",
							"documentation": "Алгоритм реализации прецедента «Регистрация и вход в систему» в форме автомата: окно входа, вход, регистрация или восстановление пароля, отправка письма. Вспомогательные прецеденты представлены состояниями с одноимёнными внутренними деятельностями — их алгоритмы приведены в ЛР2. Внутренние переменные (атрибуты вспомогательного объекта потока управления): Действие (строка) — действие, выбранное в окне: нажатая кнопка, ссылка или закрытие окна.",
							"regions": [
								{
									"_type": "UMLRegion",
									"_id": "hqjTQrotR4WJ/zxuJ04=",
									"_parent": {
										"$ref": "MpzX1fpyQlGBNneeZFs="
									},
									"vertices": [
										{
											"_type": "UMLPseudostate",
											"_id": "SbqJ+JHJSo29XWfD1O4=",
											"_parent": {
												"$ref": "hqjTQrotR4WJ/zxuJ04="
											},
											"name": "",
											"kind": "initial",
											"documentation": "Начальное псевдосостояние автомата «Регистрация и вход в систему»."
										},
										{
											"_type": "UMLPseudostate",
