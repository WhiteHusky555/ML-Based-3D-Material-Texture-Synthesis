											},
											"name": "",
											"kind": "initial",
											"documentation": "Начальное псевдосостояние автомата «Генерация материала»."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "UCsjfUw0TBazetD5QJU=",
											"_parent": {
												"$ref": "wXNi1XP9SN6b9Qc9EYY="
											},
											"name": "",
											"kind": "junction",
											"documentation": "Псевдосостояние соединения: объединяет запуск и возвраты к окну генератора."
										},
										{
											"_type": "UMLPseudostate",
											"_id": "f2vWnXtNR4+lfPxTXlY=",
											"_parent": {
												"$ref": "wXNi1XP9SN6b9Qc9EYY="
											},
											"name": "",
											"kind": "fork",
											"documentation": "Псевдосостояние разветвления: запускает параллельные состояния «Отображение окна генератора» и «Действия пользователя» — окно отображается, пока пользователь работает с ним."
										},
										{
											"_type": "UMLState",
											"_id": "kqtO0d5ISsyHJiGGdsM=",
											"_parent": {
												"$ref": "wXNi1XP9SN6b9Qc9EYY="
											},
											"name": "Отображение окна генератора",
											"entryActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "5PWDz9msRRO3a8BOFPs=",
													"_parent": {
														"$ref": "kqtO0d5ISsyHJiGGdsM="
													},
													"name": "Статус := «новая»"
												}
											],
											"doActivities": [
												{
													"_type": "UMLOpaqueBehavior",
													"_id": "kTWeF1JYQ1yF6WHyI5w=",
													"_parent": {
														"$ref": "kqtO0d5ISsyHJiGGdsM="
													},
													"name": "Показ окна и реакция на действия"
												}
											],
											"documentation": "Простое состояние: окно отображается системой параллельно с действиями пользователя; внутренняя деятельность потенциально бесконечна, выход только по событию. Окно с пресетами, превью шума плиткой 3×3, полем описания и кнопкой «Сгенерировать»; превью обновляется при изменении формы. Деятельности состояния семантически просты, отдельная диаграмма не приводится."
										},
										{
											"_type": "UMLState",
											"_id": "oiTXBJK2QzynhMHO1hQ=",
											"_parent": {
												"$ref": "wXNi1XP9SN6b9Qc9EYY="
											},
											"name": "Действия пользователя",
											"doActivities": [
