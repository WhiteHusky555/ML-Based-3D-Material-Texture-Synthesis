											},
											"name": "",
											"kind": "initial",
											"documentation": "Начальное псевдосостояние автомата «Просмотр материала в 3D»."
										},
										{
											"_type": "UMLState",
											"_id": "qjnZesskTsqLBjhuCRo=",
