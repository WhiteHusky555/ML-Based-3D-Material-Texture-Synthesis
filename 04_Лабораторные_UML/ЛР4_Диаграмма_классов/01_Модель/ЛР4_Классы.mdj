						{
							"_type": "UMLStateMachine",
							"_id": "T8GKSvAhQuKa0dSGjqY=",
							"_parent": {
								"$ref": "2fi/KCqZSNCnQFOJRrc="
							},
							"name": "Анализ показателей системы",
							"documentation": "Алгоритм реализации прецедента «Анализ показателей системы» в форме автомата: выбор отчёта, расчёт с переводом в фон по таймеру, просмотр, выгрузка CSV, выбор другого отчёта. Внутренние переменные (атрибуты вспомогательного объекта потока управления): Период (интервал дат) — период отчёта, по умолчанию последние 30 дней; Действие (строка) — действие, выбранное в окне: нажатая кнопка, ссылка или закрытие окна.",
							"regions": [
								{
