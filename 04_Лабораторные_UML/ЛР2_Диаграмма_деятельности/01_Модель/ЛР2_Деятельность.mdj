										"$ref": "N0VIFtECSguz2dTyXT8="
									},
									"name": "Передача результата на отображение",
									"documentation": "Система передаёт клиенту результат в формате JSON по схеме отчёта."
								},
								{
									"_type": "UMLActivityFinalNode",
									"_id": "gcEnApj9TrSFpRS5dHw=",
