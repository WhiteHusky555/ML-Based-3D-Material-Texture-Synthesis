<XPD:ATTR name="Name" type="string">нажата «Войти»</XPD:ATTR>
<XPD:REF name="Transition">LNsReYkRTAKkx/RVrzWFbgAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
<XPD:OBJ name="Transitions[5]" type="UMLTransition" guid="7npe9e3CQZKYS30lIqM6zAAA">
