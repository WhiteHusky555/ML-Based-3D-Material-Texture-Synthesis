<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">qHyqjY1mSMy4NQzDB/k5SwAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">2</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">SYQU8V1xRuGrvs18e5Bd5AAA</XPD:REF>
<XPD:REF name="SubmachineStates[1]">pqexp5b0SDqdW+63x/ru+wAA</XPD:REF>
</XPD:OBJ>
