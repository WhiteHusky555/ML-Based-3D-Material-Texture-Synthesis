<XPD:ATTR name="Name" type="string">TOP</XPD:ATTR>
<XPD:REF name="StateMachine">erC8O66BQvmYImx1BKC5PAAA</XPD:REF>
</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">PXP+96l7TmGcm8JjNVqKaQAA</XPD:REF>
</XPD:OBJ>
