</XPD:OBJ>
<XPD:ATTR name="#SubmachineStates" type="integer">1</XPD:ATTR>
<XPD:REF name="SubmachineStates[0]">t/8MpJbKQLmXisl99elNwQAA</XPD:REF>
</XPD:OBJ>
