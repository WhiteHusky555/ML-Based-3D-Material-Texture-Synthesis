<XPD:REF name="OwnerPartitions[0]">R61+S3WSQK6yVZ0VkmDtTwAA</XPD:REF>
<XPD:ATTR name="#Outgoings" type="integer">1</XPD:ATTR>
<XPD:REF name="Outgoings[0]">g0PlhpaYTZeGhQLhX2YZzQAA</XPD:REF>
</XPD:OBJ>
<XPD:OBJ name="Subvertices[1]" type="UMLActionState" guid="R4PKt023SMCWnvReCbELzwAA">
<XPD:ATTR name="Name" type="string">Создание платежа и запроса на оплату</XPD:ATTR>
<XPD:ATTR name="Documentation" type="string">Система создаёт запись платежа со статусом «ожидает» и ключом идемпотентности и передаёт платёжной системе запрос: сумма, валюта, назначение, идентификатор платежа, адрес возврата.</XPD:ATTR>
<XPD:REF name="ContainerState">8HeuBtehQFaJn7sVGm37GwAA</XPD:REF>
