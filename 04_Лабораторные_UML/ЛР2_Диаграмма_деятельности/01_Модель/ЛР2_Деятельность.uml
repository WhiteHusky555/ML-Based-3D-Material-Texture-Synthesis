<XPD:ATTR name="Name" type="string">нажата «Оплатить»</XPD:ATTR>
<XPD:REF name="Transition">LeNNRbmPSD+8V+XIccjNPwAA</XPD:REF>
</XPD:OBJ>
</XPD:OBJ>
